//@version=6
// XAUUSD AMD + Smart Money Swing Map
// Chart-analysis indicator only: no entry engine, simulated trades, TP/SL ledger, or order alerts.
// Swing pivots are confirmed after the selected right-side bars; all drawings are created on closed bars.
indicator("XAUUSD AMD + Smart Money Swing Map", "AMD SMC Map", overlay = true, max_boxes_count = 500, max_lines_count = 300, max_labels_count = 500)

// ----------------------------- 1 - TIME & SESSIONS -------------------------
string G_TIME = "1 - Time & Sessions"
brokerWinterGMT = input.float(2.0, "Broker Winter GMT Offset", minval = -12.0, maxval = 14.0, step = 0.5, group = G_TIME,
     tooltip = "Used for the sweep-tracking window. Example: 2 for a GMT+2 winter broker feed.")
autoBrokerDST = input.bool(true, "Broker Auto-DST (+1h approx.)", group = G_TIME,
     tooltip = "Applies a simple +1h seasonal adjustment (late March through late October). Disable for fixed-offset or UTC feeds.")
nyTimezone = input.string("America/New_York", "New York Timezone",
     options = ["America/New_York", "America/Toronto", "America/Chicago"], group = G_TIME)
track24h = input.bool(false, "24-hour sweep tracking (ignore time window)", group = G_TIME,
     tooltip = "ON tracks liquidity sweeps all day. OFF uses the broker-time window below. Session ranges and FVGs remain visible either way.")
sweepStart = input.float(10.0, "Sweep Window Start (broker hour)", minval = 0.0, maxval = 23.99, step = 0.25, group = G_TIME)
sweepEnd = input.float(20.75, "Sweep Window End (broker hour)", minval = 0.0, maxval = 23.99, step = 0.25, group = G_TIME)
showSessionBg = input.bool(true, "Shade Asia / London / New York sessions", group = G_TIME)

// ----------------------------- 2 - AMD & SMC -------------------------------
string G_MAP = "2 - AMD, Smart Money & Swing Structure"
showAmdLevels = input.bool(true, "Asian / London / Midnight AMD levels", group = G_MAP)
showPrevDayLevels = input.bool(true, "Previous Day High / Low", group = G_MAP)
showSweepZones = input.bool(true, "BSL / SSL sweep + AMD manipulation zones", group = G_MAP)
showFVG = input.bool(true, "Fair Value Gap zones", group = G_MAP)
fvgExtendBars = input.int(24, "FVG Zone Length (bars)", minval = 3, maxval = 200, group = G_MAP)
fvgZonesToKeep = input.int(80, "Recent FVG zones to keep", minval = 20, maxval = 200, group = G_MAP)
sweepZonesToKeep = input.int(60, "Recent sweep zones to keep", minval = 20, maxval = 150, group = G_MAP)

// ----------------------------- 3 - SWING MAP -------------------------------
string G_SWING = "3 - Swing & Market Structure"
showSwingStructure = input.bool(true, "Show confirmed swings, BOS and CHoCH", group = G_SWING)
swingStrength = input.int(3, "Swing Pivot Strength (left/right bars)", minval = 2, maxval = 20, group = G_SWING,
     tooltip = "A swing is confirmed only after this many bars close to its right. Larger values show fewer, stronger pivots.")
structureMarksToKeep = input.int(80, "Recent swing / BOS / CHoCH marks to keep", minval = 20, maxval = 200, group = G_SWING)
minSweepATR = input.float(0.07, "Minimum sweep depth (x ATR 14)", minval = 0.0, step = 0.01, group = G_SWING)
maxSweepATR = input.float(2.20, "Maximum sweep depth (x ATR 14)", minval = 0.1, step = 0.1, group = G_SWING)
amdConfirmBars = input.int(24, "Bars to confirm AMD distribution after a sweep", minval = 3, maxval = 200, group = G_SWING)

// --------------------------- 4 - OPTIONAL INDICATORS -----------------------
string G_IND = "4 - Optional Indicators (off by default)"
showEmaRibbon = input.bool(false, "EMA 20 / 50 / 200", group = G_IND)
showUtBot = input.bool(false, "UT-Bot ATR Trail", group = G_IND)
utKeyValue = input.float(1.0, "UT-Bot Sensitivity", minval = 0.1, step = 0.1, group = G_IND)
utAtrPeriod = input.int(21, "UT-Bot ATR Period", minval = 2, maxval = 200, group = G_IND)
showBB50 = input.bool(false, "BB50 Basis", group = G_IND)
bbLength = input.int(50, "BB Basis Period", minval = 5, maxval = 400, group = G_IND)

// ----------------------------- CLOCK HELPERS -------------------------------
f_brokerOffset(int t) =>
    float off = brokerWinterGMT
    if autoBrokerDST
        int m = month(t, "UTC")
        int d = dayofmonth(t, "UTC")
        if (m > 3 and m < 10) or (m == 3 and d >= 28) or (m == 10 and d < 26)
            off := brokerWinterGMT + 1.0
    off

f_brokerHour(int t) =>
    float raw = hour(t, "UTC") + minute(t, "UTC") / 60.0 + f_brokerOffset(t)
    raw >= 24.0 ? raw - 24.0 : raw < 0.0 ? raw + 24.0 : raw

f_nyHour(int t) =>
    hour(t, nyTimezone) + minute(t, nyTimezone) / 60.0

f_tradingDayKey(int t) =>
    int shifted = t + 21600000
    year(shifted, nyTimezone) * 372 + month(shifted, nyTimezone) * 31 + dayofmonth(shifted, nyTimezone)

f_sweptHigh(float level, float h, float cl, float minDepth, float maxDepth) =>
    not na(level) and h > level + minDepth and cl < level and h - level <= maxDepth

f_sweptLow(float level, float l, float cl, float minDepth, float maxDepth) =>
    not na(level) and l < level - minDepth and cl > level and level - l <= maxDepth

// ----------------------------- CORE SERIES ---------------------------------
float atr14 = ta.atr(14)
float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float bbBasis = ta.sma(close, bbLength)
float utAtr = ta.atr(utAtrPeriod)
float utLoss = utKeyValue * utAtr

var float utStop = na
utStop := na(utStop[1]) ? close : close > utStop[1] and close[1] > utStop[1] ? math.max(utStop[1], close - utLoss) : close < utStop[1] and close[1] < utStop[1] ? math.min(utStop[1], close + utLoss) : close > utStop[1] ? close - utLoss : close + utLoss

float pivotHigh = ta.pivothigh(high, swingStrength, swingStrength)
float pivotLow = ta.pivotlow(low, swingStrength, swingStrength)
float recentHigh20 = ta.highest(high[1], 20)
float recentLow20 = ta.lowest(low[1], 20)
float nyHour = f_nyHour(time)
float brokerHour = f_brokerHour(time)
int barMillis = int(nz(timeframe.in_seconds(timeframe.period), 900) * 1000)

bool inAsia = nyHour >= 18.0 or nyHour < 2.0
bool inLondon = nyHour >= 2.0 and nyHour < 7.0
bool inNyAm = nyHour >= 8.0 and nyHour < 11.0
bool inNyPm = nyHour >= 13.0 and nyHour < 16.0
bool inSweepWindow = sweepStart <= sweepEnd ? (brokerHour >= sweepStart and brokerHour <= sweepEnd) : (brokerHour >= sweepStart or brokerHour <= sweepEnd)
bool trackSweepsNow = track24h or inSweepWindow

// ---------------------------- PERSISTENT MAP STATE -------------------------
var int activeDayKey = na
var float dayHigh = na
var float dayLow = na
var float previousDayHigh = na
var float previousDayLow = na
var float asianHigh = na
var float asianLow = na
var float londonHigh = na
var float londonLow = na
var float midnightOpen = na

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighTime = na
var int lastSwingLowTime = na
var bool lastSwingHighBroken = false
var bool lastSwingLowBroken = false
var int structureTrend = 0
var int amdManipulationDirection = 0  // +1 after SSL sweep; -1 after BSL sweep
var int amdSweepBar = na

var array<box> fvgBoxes = array.new<box>()
var array<box> sweepBoxes = array.new<box>()
var array<label> sweepLabels = array.new<label>()
var array<label> structureLabels = array.new<label>()
var array<line> structureLines = array.new<line>()

// Only closed candles update session levels, pivots, zones and structure labels.
if barstate.isconfirmed
    int dayKey = f_tradingDayKey(time)
    if na(activeDayKey)
        activeDayKey := dayKey
        dayHigh := high
        dayLow := low
    else if dayKey != activeDayKey
        previousDayHigh := dayHigh
        previousDayLow := dayLow
        activeDayKey := dayKey
        dayHigh := high
        dayLow := low
        asianHigh := na
        asianLow := na
        londonHigh := na
        londonLow := na
        midnightOpen := na

    dayHigh := na(dayHigh) ? high : math.max(dayHigh, high)
    dayLow := na(dayLow) ? low : math.min(dayLow, low)

    if inAsia
        asianHigh := na(asianHigh) ? high : math.max(asianHigh, high)
        asianLow := na(asianLow) ? low : math.min(asianLow, low)
    if inLondon
        londonHigh := na(londonHigh) ? high : math.max(londonHigh, high)
        londonLow := na(londonLow) ? low : math.min(londonLow, low)
    if nyHour >= 0.0 and nyHour < 2.0 and na(midnightOpen)
        midnightOpen := open

    // Confirmed swing points; labels are anchored at the pivot only after right-side bars close.
    if not na(pivotHigh)
        lastSwingHigh := pivotHigh
        lastSwingHighTime := time[swingStrength]
        lastSwingHighBroken := false
        if showSwingStructure
            label swingHighTag = label.new(time[swingStrength], pivotHigh, "SWH", xloc.bar_time, yloc.price, color.new(#F9A825, 5), label.style_label_down, color.black, size.tiny)
            array.push(structureLabels, swingHighTag)
            if array.size(structureLabels) > structureMarksToKeep
                label.delete(array.shift(structureLabels))
    if not na(pivotLow)
        lastSwingLow := pivotLow
        lastSwingLowTime := time[swingStrength]
        lastSwingLowBroken := false
        if showSwingStructure
            label swingLowTag = label.new(time[swingStrength], pivotLow, "SWL", xloc.bar_time, yloc.price, color.new(#F9A825, 5), label.style_label_up, color.black, size.tiny)
            array.push(structureLabels, swingLowTag)
            if array.size(structureLabels) > structureMarksToKeep
                label.delete(array.shift(structureLabels))

    if not na(amdSweepBar) and bar_index - amdSweepBar > amdConfirmBars
        amdManipulationDirection := 0
        amdSweepBar := na

    // Find the nearest valid buy-side and sell-side liquidity pools swept and reclaimed on this close.
    float sweepMin = math.max(minSweepATR * atr14, syminfo.mintick)
    float sweepMax = maxSweepATR * atr14
    float bslSweepLevel = na
    float sslSweepLevel = na
    if showSweepZones and trackSweepsNow and not na(atr14)
        if f_sweptHigh(asianHigh, high, close, sweepMin, sweepMax)
            bslSweepLevel := na(bslSweepLevel) ? asianHigh : math.min(bslSweepLevel, asianHigh)
        if f_sweptHigh(londonHigh, high, close, sweepMin, sweepMax)
            bslSweepLevel := na(bslSweepLevel) ? londonHigh : math.min(bslSweepLevel, londonHigh)
        if f_sweptHigh(previousDayHigh, high, close, sweepMin, sweepMax)
            bslSweepLevel := na(bslSweepLevel) ? previousDayHigh : math.min(bslSweepLevel, previousDayHigh)
        if f_sweptHigh(lastSwingHigh, high, close, sweepMin, sweepMax)
            bslSweepLevel := na(bslSweepLevel) ? lastSwingHigh : math.min(bslSweepLevel, lastSwingHigh)
        if f_sweptHigh(recentHigh20, high, close, sweepMin, sweepMax)
            bslSweepLevel := na(bslSweepLevel) ? recentHigh20 : math.min(bslSweepLevel, recentHigh20)
        if f_sweptLow(asianLow, low, close, sweepMin, sweepMax)
            sslSweepLevel := na(sslSweepLevel) ? asianLow : math.max(sslSweepLevel, asianLow)
        if f_sweptLow(londonLow, low, close, sweepMin, sweepMax)
            sslSweepLevel := na(sslSweepLevel) ? londonLow : math.max(sslSweepLevel, londonLow)
        if f_sweptLow(previousDayLow, low, close, sweepMin, sweepMax)
            sslSweepLevel := na(sslSweepLevel) ? previousDayLow : math.max(sslSweepLevel, previousDayLow)
        if f_sweptLow(lastSwingLow, low, close, sweepMin, sweepMax)
            sslSweepLevel := na(sslSweepLevel) ? lastSwingLow : math.max(sslSweepLevel, lastSwingLow)
        if f_sweptLow(recentLow20, low, close, sweepMin, sweepMax)
            sslSweepLevel := na(sslSweepLevel) ? recentLow20 : math.max(sslSweepLevel, recentLow20)

    int zoneRight = time + barMillis * 24
    if showSweepZones and not na(bslSweepLevel)
        box bslZone = box.new(time, high, zoneRight, bslSweepLevel, color.new(#EF5350, 35), 1, line.style_dashed, extend.none, xloc.bar_time, color.new(#EF5350, 88))
        label bslTag = label.new(time, high, "BSL SWEEP\nAMD MANIP", xloc.bar_time, yloc.price, color.new(#C62828, 5), label.style_label_down, color.white, size.tiny)
        array.push(sweepBoxes, bslZone)
        array.push(sweepLabels, bslTag)
        if array.size(sweepBoxes) > sweepZonesToKeep
            box.delete(array.shift(sweepBoxes))
            label.delete(array.shift(sweepLabels))
    if showSweepZones and not na(sslSweepLevel)
        box sslZone = box.new(time, sslSweepLevel, zoneRight, low, color.new(#26A69A, 35), 1, line.style_dashed, extend.none, xloc.bar_time, color.new(#26A69A, 88))
        label sslTag = label.new(time, low, "SSL SWEEP\nAMD MANIP", xloc.bar_time, yloc.price, color.new(#00796B, 5), label.style_label_up, color.white, size.tiny)
        array.push(sweepBoxes, sslZone)
        array.push(sweepLabels, sslTag)
        if array.size(sweepBoxes) > sweepZonesToKeep
            box.delete(array.shift(sweepBoxes))
            label.delete(array.shift(sweepLabels))

    if not na(bslSweepLevel) and na(sslSweepLevel)
        amdManipulationDirection := -1
        amdSweepBar := bar_index
    else if not na(sslSweepLevel) and na(bslSweepLevel)
        amdManipulationDirection := 1
        amdSweepBar := bar_index
    else if not na(bslSweepLevel) and not na(sslSweepLevel)
        amdManipulationDirection := 0
        amdSweepBar := na

    bool breakUp = not na(lastSwingHigh) and not lastSwingHighBroken and close > lastSwingHigh
    bool breakDown = not na(lastSwingLow) and not lastSwingLowBroken and close < lastSwingLow
    if breakUp and not breakDown
        bool isChochUp = structureTrend == -1
        bool isAmdDistributionUp = amdManipulationDirection == 1 and not na(amdSweepBar) and bar_index > amdSweepBar and bar_index - amdSweepBar <= amdConfirmBars
        string upText = (isChochUp ? "CHoCH UP" : "BOS UP") + (isAmdDistributionUp ? "\nAMD DISTRIBUTION" : "")
        color upColor = isAmdDistributionUp ? color.new(#00897B, 0) : color.new(#2E7D32, 0)
        if showSwingStructure
            line upBreakLine = line.new(lastSwingHighTime, lastSwingHigh, time, lastSwingHigh, xloc.bar_time, extend.none, upColor, line.style_dashed, 1)
            label upBreakTag = label.new(time, high, upText, xloc.bar_time, yloc.price, upColor, label.style_label_down, color.white, size.small)
            array.push(structureLines, upBreakLine)
            array.push(structureLabels, upBreakTag)
            if array.size(structureLines) > structureMarksToKeep
                line.delete(array.shift(structureLines))
            if array.size(structureLabels) > structureMarksToKeep
                label.delete(array.shift(structureLabels))
        lastSwingHighBroken := true
        structureTrend := 1
        if isAmdDistributionUp
            amdManipulationDirection := 0
            amdSweepBar := na
    else if breakDown and not breakUp
        bool isChochDown = structureTrend == 1
        bool isAmdDistributionDown = amdManipulationDirection == -1 and not na(amdSweepBar) and bar_index > amdSweepBar and bar_index - amdSweepBar <= amdConfirmBars
        string downText = (isChochDown ? "CHoCH DOWN" : "BOS DOWN") + (isAmdDistributionDown ? "\nAMD DISTRIBUTION" : "")
        color downColor = isAmdDistributionDown ? color.new(#C62828, 0) : color.new(#B71C1C, 0)
        if showSwingStructure
            line downBreakLine = line.new(lastSwingLowTime, lastSwingLow, time, lastSwingLow, xloc.bar_time, extend.none, downColor, line.style_dashed, 1)
            label downBreakTag = label.new(time, low, downText, xloc.bar_time, yloc.price, downColor, label.style_label_up, color.white, size.small)
            array.push(structureLines, downBreakLine)
            array.push(structureLabels, downBreakTag)
            if array.size(structureLines) > structureMarksToKeep
                line.delete(array.shift(structureLines))
            if array.size(structureLabels) > structureMarksToKeep
                label.delete(array.shift(structureLabels))
        lastSwingLowBroken := true
        structureTrend := -1
        if isAmdDistributionDown
            amdManipulationDirection := 0
            amdSweepBar := na
    else if breakUp and breakDown
        lastSwingHighBroken := true
        lastSwingLowBroken := true

    bool bullFvg = bar_index >= 2 and low > high[2]
    bool bearFvg = bar_index >= 2 and high < low[2]
    int fvgRight = time + barMillis * fvgExtendBars
    if showFVG and bullFvg
        box bullFvgBox = box.new(time[2], low, fvgRight, high[2], color.new(#26A69A, 35), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(#26A69A, 88))
        array.push(fvgBoxes, bullFvgBox)
        if array.size(fvgBoxes) > fvgZonesToKeep
            box.delete(array.shift(fvgBoxes))
    if showFVG and bearFvg
        box bearFvgBox = box.new(time[2], low[2], fvgRight, high, color.new(#EF5350, 35), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(#EF5350, 88))
        array.push(fvgBoxes, bearFvgBox)
        if array.size(fvgBoxes) > fvgZonesToKeep
            box.delete(array.shift(fvgBoxes))

// ----------------------------- AMD RANGE LEVELS ----------------------------
pAsiaHigh = plot(showAmdLevels ? asianHigh : na, "AMD - Asian High", color.new(#FFD54F, 5), 1, plot.style_linebr)
pAsiaLow = plot(showAmdLevels ? asianLow : na, "AMD - Asian Low", color.new(#FFD54F, 5), 1, plot.style_linebr)
fill(pAsiaHigh, pAsiaLow, color.new(#FFD54F, 94), title = "AMD Accumulation Range")
plot(showAmdLevels ? londonHigh : na, "AMD - London High", color.new(#90A4AE, 10), 1, plot.style_linebr)
plot(showAmdLevels ? londonLow : na, "AMD - London Low", color.new(#90A4AE, 10), 1, plot.style_linebr)
plot(showAmdLevels ? midnightOpen : na, "AMD - Midnight Open", color.new(#26C6DA, 15), 1, plot.style_linebr)
plot(showPrevDayLevels ? previousDayHigh : na, "Liquidity - Previous Day High", color.new(#FF7043, 0), 1, plot.style_linebr)
plot(showPrevDayLevels ? previousDayLow : na, "Liquidity - Previous Day Low", color.new(#42A5F5, 0), 1, plot.style_linebr)
plot(showSwingStructure ? lastSwingHigh : na, "Swing - Latest High", color.new(#FFCA28, 25), 1, plot.style_stepline)
plot(showSwingStructure ? lastSwingLow : na, "Swing - Latest Low", color.new(#FFCA28, 25), 1, plot.style_stepline)

color sessionBg = inAsia ? color.new(#1E88E5, 96) : inLondon ? color.new(#8E24AA, 96) : inNyAm ? color.new(#FB8C00, 96) : inNyPm ? color.new(#5E35B1, 96) : na
bgcolor(showSessionBg ? sessionBg : na, title = "Asia / London / New York")

// Optional trend overlays are plotted from confirmed-bar values to avoid intrabar flicker.
float ema20Confirmed = barstate.isconfirmed ? ema20 : ema20[1]
float ema50Confirmed = barstate.isconfirmed ? ema50 : ema50[1]
float ema200Confirmed = barstate.isconfirmed ? ema200 : ema200[1]
float bbBasisConfirmed = barstate.isconfirmed ? bbBasis : bbBasis[1]
float utStopConfirmed = barstate.isconfirmed ? utStop : utStop[1]
bool utBullConfirmed = barstate.isconfirmed ? close > utStop : close[1] > utStop[1]
plot(showEmaRibbon ? ema20Confirmed : na, "EMA 20", color.new(#29B6F6, 15), 1)
plot(showEmaRibbon ? ema50Confirmed : na, "EMA 50", color.new(#FFB300, 5), 2)
plot(showEmaRibbon ? ema200Confirmed : na, "EMA 200", color.new(#AB47BC, 5), 2)
plot(showBB50 ? bbBasisConfirmed : na, "BB50 Basis", color.new(#78909C, 15), 1, plot.style_cross)
plot(showUtBot ? utStopConfirmed : na, "UT-Bot ATR Trail", utBullConfirmed ? color.new(#00C853, 0) : color.new(#F44336, 0), 2)
