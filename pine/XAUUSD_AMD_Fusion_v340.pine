string G6 = "6 · Approximated Footprint (tick-volume based)"
showFootprint      = input.bool (false,"Show Footprint Columns", group = G6,
     tooltip = "TradingView only provides one aggregate volume per bar, so volume is redistributed over the bar's OHLC path and delta is estimated from close-location + intra-bar tilt. Directional information, not real bid/ask data.")
fpBars             = input.int  (20,   "Footprint Bars Back", minval = 3, maxval = 60, group = G6)
fpRows             = input.int  (8,    "Price Rows per Bar",  minval = 3, maxval = 24, group = G6)
fpImbalance        = input.float(3.0,  "Diagonal Imbalance Ratio (×)", minval = 1.1, maxval = 10.0, step = 0.1, group = G6)
fpTilt             = input.float(0.35, "Delta Tilt Across the Bar", minval = 0.0, maxval = 1.0, step = 0.05, group = G6)
fpMinVol           = input.float(0.0,  "Min Bar Volume to Draw", minval = 0.0, group = G6)
fpText             = input.bool (true, "Show Volume Text in Cells", group = G6)

