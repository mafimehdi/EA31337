tblBg              = input.color(color.new(#0b1020, 8), "Table Background", group = G7)
tblFg              = input.color(color.new(color.white, 0), "Table Text", group = G7)

// ═══════════════════════════════════════════════════════════════════════════
//  DERIVED CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════
bool  isPresetA   = preset == "HYBRID_04 Base + Engine4 SP2L"
bool  isPresetB   = preset == "M15 NY + London 10:00"

// Preset A / B override the same globals the MQL ApplyM15Preset() writes.
float pRrTarget   = isPresetA ? 1.95 : isPresetB ? 1.85 : rrTarget
bool  pPreset     = isPresetA or isPresetB
float pSlBuf      = pPreset ? 0.22 : slBufferATR
float pMinSlPct   = pPreset ? 0.27 : minSLPct
float pMaxSlPct   = isPresetA ? 0.482 : isPresetB ? 0.50 : maxSLPct
float pMinSweep   = isPresetA ? 0.07 : isPresetB ? 0.05 : minSweepATR
float pMaxSweep   = pPreset ? 2.20 : maxSweepATR
int   pMaxMss     = pPreset ? 6 : maxBarsMSS
float pDispBody   = pPreset ? 0.25 : dispBodyATR
bool  pLondon     = isPresetA ? false : isPresetB ? true : enableLondon
bool  pStrictEma  = pPreset ? true : strictEma
bool  pEng1       = pPreset ? true : eng1On
bool  pEng2       = pPreset ? true : eng2On
bool  pEng3       = pPreset ? false : eng3On
bool  pSbSell     = pPreset ? false : allowSbSell
int   pCooldown   = cooldownBars
int   pMaxNyAm    = maxNyAm
int   pMaxNyPm    = maxNyPm
bool  pSkipWhip   = skipWhip
bool  pSkipLate   = skipLateBuys
float pPullback   = fvgPullback
int   pExpiry     = pendingExpiryBars
bool  pMarketEntry = entryModeStr == "Market on Confirmation Close"

int   gfScope     = gfScopeStr == "Off (pure AMD)" ? 0 : gfScopeStr == "Engine 4 + PRE_NY only" ? 1 : gfScopeStr == "BUY signals (+ Engine 4)" ? 2 : 3
float tickSize    = syminfo.mintick
float spreadPrice = math.max(0.0, simSpreadPoints) * tickSize
string lblSz      = lblSize == "tiny" ? size.tiny : lblSize == "normal" ? size.normal : size.small
string tblSz      = tblSize == "tiny" ? size.tiny : tblSize == "large" ? size.large : tblSize == "normal" ? size.normal : size.small
bool  pessimistic = intrabarMode == "Pessimistic (SL first)"
bool  optimistic  = intrabarMode == "Optimistic (trigger first)"
bool  noSameBar   = intrabarMode == "No same-bar exit"
bool  correctTf   = timeframe.in_seconds(timeframe.period) == 900

