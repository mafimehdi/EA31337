var float bullSweptLevel  = 0.0
var float bullManipLow    = 1e9
var int   bullSweepTime   = na
var bool  bearSweepActive = false
var int   bearSweepBars   = 0
var float bearSweptLevel  = 0.0
var float bearManipHigh   = 0.0
var int   bearSweepTime   = na

