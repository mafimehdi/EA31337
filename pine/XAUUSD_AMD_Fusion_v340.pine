balancePer001      = input.float(165.0, "Balance per 0.01 Lot ($)", minval = 1.0, group = G1)
riskPct            = input.float(3.0,   "Risk % of Balance per Trade", minval = 0.0, maxval = 25.0, step = 0.1, group = G1)
fixedLotsFallback  = input.float(0.01,  "Base Lot Size", minval = 0.01, step = 0.01, group = G1)
rrTarget           = input.float(1.95,  "Take-Profit R:R", minval = 0.2, step = 0.05, group = G1)
useStepLock        = input.bool (true,  "3-Stage Step-Lock Trailing", group = G1)
trigStep1          = input.float(0.92,  "Step 1 Trigger (R)", step = 0.01, group = G1)
lockStep1          = input.float(0.60,  "Step 1 Lock (R)",    step = 0.01, group = G1)
trigStep2          = input.float(1.30,  "Step 2 Trigger (R)", step = 0.01, group = G1)
lockStep2          = input.float(1.15,  "Step 2 Lock (R)",    step = 0.01, group = G1)
trigStep3          = input.float(1.62,  "Step 3 Trigger (R)", step = 0.01, group = G1)
lockStep3          = input.float(1.50,  "Step 3 Lock (R)",    step = 0.01, group = G1)
usePartial         = input.bool (true,  "50% Partial Close at Step 1", group = G1)
partialPct         = input.float(50.0,  "Partial Size (%)", minval = 0.0, maxval = 100.0, group = G1)
slBufferATR        = input.float(0.22,  "SL Buffer behind Manipulation Wick (×ATR14)", step = 0.01, group = G1)
minSLPct           = input.float(0.27,  "Min SL (% of price)", minval = 0.0, step = 0.01, group = G1)
maxSLPct           = input.float(0.482,"Max SL (% of price)", minval = 0.0, group = G1)

string G1b = "1b · Simulation Accounting"
startBalance       = input.float(500.0,  "Starting Balance ($)", minval = 1.0, group = G1b)
contractSize       = input.float(100.0,  "Contract Size (oz per 1.00 lot)", minval = 1.0, group = G1b,
     tooltip = "XAUUSD standard = 100 oz → $1.00 move on 1.00 lot = $100.")
lotStepIn          = input.float(0.01,   "Lot Step", minval = 0.001, step = 0.001, group = G1b)
minLotIn           = input.float(0.01,   "Min Lot",  minval = 0.001, step = 0.001, group = G1b)
maxLotIn           = input.float(100.0,  "Max Lot",  minval = 0.01,  group = G1b)
commissionPerLot   = input.float(0.0,    "Round-Turn Commission per 1.00 lot ($)", minval = 0.0, group = G1b)
simSpreadPoints    = input.float(25.0,   "Simulated Spread (points)", minval = 0.0, group = G1b,
     tooltip = "TradingView has no Bid/Ask. 1 point = syminfo.mintick. Used for the SL offset and as the cost of market/partial fills.")
intrabarMode       = input.string("Pessimistic (SL first)", "Intra-Bar Fill Assumption",
     options = ["Pessimistic (SL first)", "Optimistic (trigger first)", "No same-bar exit"], group = G1b,
     tooltip = "Decides what happens when a single bar contains both the trigger and the stop. Pessimistic never overstates the backtest.")

