var string intentWindow    = ""
var float  intentAtr       = na
var int    intentBar       = na
var int    intentSpike     = na

// Counters / accounting
var int   barsSinceEntry  = 999
var int   lastSpikeTime   = na
var float balance         = startBalance
var float peakBalance     = startBalance
var float maxDrawdown     = 0.0
var float maxDrawdownPct  = 0.0
var int   trades          = 0
var int   wins            = 0
var int   losses          = 0
var int   tpHits          = 0
var int   slHits          = 0
var int   lockExits       = 0
var int   shieldExits     = 0
var int   sessionExits    = 0
var int   expiredPendings = 0
var int   partialCount    = 0
var float grossProfit     = 0.0
var float grossLoss       = 0.0
var float netProfit       = 0.0
var float sumR            = 0.0
var float sumWinR         = 0.0
var float sumLossR        = 0.0
var float bestR           = 0.0
var float worstR          = 0.0
var int   consecWin       = 0
var int   consecLoss      = 0
var int   maxConsecWin    = 0
var int   maxConsecLoss   = 0
var float floatPnl        = 0.0
var int   buyTrades       = 0
var int   buyWins         = 0
var float buyPnl          = 0.0
var int   sellTrades      = 0
var int   sellWins        = 0
var float sellPnl         = 0.0

// Per-window order counters (incremented when the order is *placed*, like the EA)
var int   lonTradesC      = 0
var int   preNyTradesC    = 0
var int   nyAmTradesC     = 0
var int   nyPmTradesC     = 0

// Per-engine (0 AMD, 1 L3_SWEEP, 2 SILVER_B, 3 GF_SP2L, 4 other) and
// per-window (0 NY_AM, 1 NY_PM, 2 PRE_NY, 3 LON10, 4 other) breakdowns
var array<float> engTrades = array.new<float>(5, 0)
var array<float> engWins   = array.new<float>(5, 0)
var array<float> engPnl    = array.new<float>(5, 0)
var array<float> winTrades = array.new<float>(5, 0)
var array<float> winWins   = array.new<float>(5, 0)
var array<float> winPnl    = array.new<float>(5, 0)

// Drawing handles
var line  slLine       = na
var line  tpLine       = na
var line  entryLine    = na
var line  s1Line       = na
var line  s2Line       = na
var line  s3Line       = na
var line  pendLine     = na
var line  pendSlLine   = na
var line  pendTpLine   = na
var label pendLbl      = na
var line  bullSweepLn  = na
var box   bullSweepBx  = na
var line  bearSweepLn  = na
var box   bearSweepBx  = na
var array<box>   fpBoxes  = array.new<box>()
var array<label> fpLabels = array.new<label>()
var table statsTbl     = na
var table brkTbl       = na
var table dashTbl      = na
var table warnTbl      = na

// Per-bar outputs consumed by the plot/alert layer
float sigDirOut      = 0
string sigEngineOut  = ""
string sigWindowOut  = ""
string lastEvent     = "—"
bool   evEntry       = false
bool   evExit        = false
bool   evPartial     = false
bool   evShield      = false
bool   evSignal      = false
float  lastTradeR    = 0.0
float  lastTradePnl  = 0.0
float  lastExitPrice = na
string lastExitWhy   = ""

// ═══════════════════════════════════════════════════════════════════════════
//  PURE HELPER FUNCTIONS  (read-only: Pine forbids global mutation in funcs)
// ═══════════════════════════════════════════════════════════════════════════

// ── Broker / New-York clock (mirrors GetNewYorkTime + GetBrokerDecimalHour) ──
f_brokerOffset(int t) =>
    float off = brokerWinterGMT
    if autoBrokerDST
        int m = month(t, "UTC")
        int d = dayofmonth(t, "UTC")
        if (m > 3 and m < 10) or (m == 3 and d >= 28) or (m == 10 and d < 26)
            off := brokerWinterGMT + 1.0
    off

f_brokerHour(int t) =>
    float raw = hour(t, "UTC") + minute(t, "UTC") / 60.0 + f_brokerOffset(t)
    raw >= 24.0 ? raw - 24.0 : raw < 0.0 ? raw + 24.0 : raw

f_brokerClock(int t) =>
    float bh = f_brokerHour(t)
    int h = math.floor(bh)
    int m = math.floor((bh - h) * 60)
    str.tostring(h, "00") + ":" + str.tostring(m, "00")

f_nyHour(int t) =>
    hour(t, nyTimezone) + minute(t, nyTimezone) / 60.0

f_nyClock(int t) =>
    float nh = f_nyHour(t)
    int h = math.floor(nh)
    int m = math.floor((nh - h) * 60)
    str.tostring(h, "00") + ":" + str.tostring(m, "00")

// Trading-day rollover at 18:00 New York (GetTradingDayID: NY time + 6h)
f_dayKey(int t) =>
    int ts = t + 21600000
    year(ts, nyTimezone) * 372 + month(ts, nyTimezone) * 31 + dayofmonth(ts, nyTimezone)

// ── Formatting ──
f_money(float x) =>
    (x < 0 ? "-$" : "$") + str.tostring(math.abs(x), "#,###.##")

f_r(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "#.##") + "R"

f_pct(float x) =>
    str.tostring(x, "#.##") + "%"

f_vol(float x) =>
    x >= 1000000 ? str.tostring(x / 1000000, "#.##") + "M" : x >= 1000 ? str.tostring(x / 1000, "#.#") + "K" : str.tostring(math.round(x), "#")

f_px(float x) =>
    str.tostring(x, format.mintick)

f_lots(float x) =>
    str.tostring(x, "#.##") + " lots"

// ── Lot sizing (CalculatePositionLots) ──
f_normLots(float x) =>
    float stp = lotStepIn > 0 ? lotStepIn : 0.01
    float mn  = minLotIn > 0 ? minLotIn : 0.01
    float mx  = maxLotIn > 0 ? maxLotIn : 100.0
    math.max(mn, math.min(mx, math.round(math.floor(x / stp) * stp, 3)))

f_calcLots(float slDist, float bal) =>
    float lots = f_normLots(fixedLotsFallback)
    if useStepCompounding and slDist > 0
        float riskMoney  = bal * riskPct / 100.0
        float lossPerLot = slDist * contractSize
        float riskLots   = lossPerLot > 0 ? riskMoney / lossPerLot : fixedLotsFallback
        float stepLots   = fixedLotsFallback
        if balancePer001 > 0
            stepLots := math.max(fixedLotsFallback, math.floor(bal / balancePer001) * 0.01)
        lots := f_normLots(math.max(riskLots, stepLots))
    lots

// ── GoldFusion filters ──
f_utAllow(int dir, float cl, float utStop) =>
    bool ok = true
    if useUT and not na(utStop) and utStop > 0
        ok := dir > 0 ? cl > utStop : cl < utStop
    ok

f_bbAllow(int dir, float cl, float b1, float b2) =>
    bool ok = true
    if useBB50 and b1 > 0 and b2 > 0
        ok := dir > 0 ? (cl > b1 and b1 > b2) : (cl < b1 and b1 < b2)
    ok

f_gfAllow(int dir, bool isE4, float cl, float utStop, float b1, float b2) =>
    bool ok = true
    if gfScope == 1 and not isE4
        ok := true
    else if gfScope == 2 and dir < 0 and not isE4
        ok := true
    else if gfScope == 3 or gfScope == 1 or gfScope == 2
        ok := f_utAllow(dir, cl, utStop) and f_bbAllow(dir, cl, b1, b2)
    ok

// ── Engine 4 · GoldFusion SP2L ──────────────────────────────────────────────
// 2-bar spike (>=1.2×ATR21, body>=45%, FVG gap) + 2-leg pullback + breakout.
// MQL loop  s = 2..maxLegBars+2  ⇒  Pine offsets m = s-1 = 1..maxLegBars+1
// (every MQL Bar[k] is Pine Bar[k-1] because the EA runs one bar later).
f_sp2l(bool bullBias, bool bearBias, bool bullCQ, bool bearCQ, float atr21, int lastSpike) =>
    int   dirOut = 0
    float extOut = na
    int   tOut   = na
    int n    = math.max(1, math.round(sp2lSpikeBars))
    int maxM = math.max(2, math.round(sp2lMaxLegBars) + 1)
    if atr21 > 0
        bool doneBull = false
        if bullBias and bullCQ and close > open and close > high[1]
            for m = 1 to maxM
                if not doneBull and bar_index >= m + n + 3
                    float origin = math.min(low[m + n], low[m + n - 1])
                    float hh     = 0.0
                    bool  spike  = true
                    for k = 0 to n - 1
                        float o_  = open[m + k]
                        float c_  = close[m + k]
                        float rng = high[m + k] - low[m + k]
                        spike := spike and c_ > o_ and rng > 0 and (c_ - o_) / rng >= sp2lMinBodyRatio
                        hh := math.max(hh, high[m + k])
                    spike := spike and (hh - origin) >= sp2lMinSpikeATR * atr21
                    if spike and sp2lRequireGap and n >= 2
                        bool gap = false
                        for k = 0 to n - 2
                            if low[m + k] > high[m + k + 2]
                                gap := true
                        spike := gap
                    if spike
                        doneBull := true
                        if time[m] != lastSpike and (not sp2lStrictBreak or close > hh)
                            bool  leg    = false
                            float legMin = low
                            if m >= 2
                                for j = 1 to m - 1
                                    int idx = m - j
                                    if low[idx] >= origin
                                        legMin := math.min(legMin, low[idx])
                                        if low[idx] <= low[idx + 1]
                                            leg := true
                                    else
                                        break
                            if leg and low > origin
                                dirOut := 1
                                extOut := math.min(legMin, low)
                                tOut   := time[m]
        bool doneBear = false
        if dirOut == 0 and not doneBull and bearBias and bearCQ and close < open and close < low[1]
            for m = 1 to maxM
                if not doneBear and bar_index >= m + n + 3
                    float origin = math.max(high[m + n], high[m + n - 1])
                    float ll     = 1e12
                    bool  spike  = true
                    for k = 0 to n - 1
                        float o_  = open[m + k]
                        float c_  = close[m + k]
                        float rng = high[m + k] - low[m + k]
                        spike := spike and c_ < o_ and rng > 0 and (o_ - c_) / rng >= sp2lMinBodyRatio
                        ll := math.min(ll, low[m + k])
                    spike := spike and (origin - ll) >= sp2lMinSpikeATR * atr21
                    if spike and sp2lRequireGap and n >= 2
                        bool gap = false
                        for k = 0 to n - 2
                            if high[m + k] < low[m + k + 2]
                                gap := true
                        spike := gap
                    if spike
                        doneBear := true
                        if time[m] != lastSpike and (not sp2lStrictBreak or close < ll)
                            bool  leg    = false
                            float legMax = high
                            if m >= 2
                                for j = 1 to m - 1
                                    int idx = m - j
                                    if high[idx] <= origin
                                        legMax := math.max(legMax, high[idx])
                                        if high[idx] >= high[idx + 1]
                                            leg := true
                                    else
                                        break
                            if leg and high < origin
                                dirOut := -1
                                extOut := math.max(legMax, high)
                                tOut   := time[m]
    [dirOut, extOut, tOut]

// ── GoldFusion pullback vote used by the reversal-quorum shield ─────────────
f_pbVote(float ema50s, float ema200s) =>
    int v = 0
    float e200 = ema200s
    if e200 > 0
        if close > e200 and close > open and close > high[1]
            for k = 0 to 13
                if low[k] <= ema50s[k] and close[k] > ema200s[k]
                    v := 1
                    break
        else if close < e200 and close < open and close < low[1]
            for k = 0 to 13
                if high[k] >= ema50s[k] and close[k] < ema200s[k]
                    v := -1
                    break
    v

// ── Stat indexes ──
f_engIdx(string tag) =>
    tag == "AMD" ? 0 : tag == "L3_SWEEP" ? 1 : tag == "SILVER_B" ? 2 : tag == "GF_SP2L" ? 3 : 4

f_winIdx(string w) =>
    w == "NY_AM" ? 0 : w == "NY_PM" ? 1 : w == "PRE_NY" ? 2 : w == "LON10" ? 3 : 4

// ── Table positions (switch on the input keeps the required "input string" form) ──
statsPos = switch tblPos
    "top_left"     => position.top_left
    "bottom_right" => position.bottom_right
    "bottom_left"  => position.bottom_left
    "middle_right" => position.middle_right
    => position.top_right

dashPos2 = switch dashPos
    "top_right"    => position.top_right
    "bottom_right" => position.bottom_right
    "top_left"     => position.top_left
    "middle_right" => position.middle_right
    => position.bottom_left

brkPos = switch tblPos
    "top_right"    => position.bottom_right
    "top_left"     => position.bottom_left
    "bottom_right" => position.top_right
    "bottom_left"  => position.top_left
    => position.middle_right

// ═══════════════════════════════════════════════════════════════════════════
//  INDICATOR LAYER  (computed on every bar, closed-bar data only)
// ═══════════════════════════════════════════════════════════════════════════
atr1     = ta.atr(14)                       // EA iATR(14, shift 1)
atr1p    = nz(atr1[1])                      // EA iATR(14, shift 2)
atr21    = ta.atr(utAtrPeriod)              // UT-Bot / SP2L ATR21
ema20    = ta.ema(close, 20)
ema50    = ta.ema(close, 50)
ema50p4  = nz(ema50[4])                     // EA shift 5
ema200   = ta.ema(close, 200)
ema200p8 = nz(ema200[8])                    // EA shift 9
bbBasis  = ta.sma(close, bbLength)
bbBasis1 = nz(bbBasis[1])

// UT-Bot ATR trailing stop — recursive, so the warm-up problem that the EA had to
// patch with a 120-bar replay loop simply does not exist here.
utNloss   = utKeyValue * atr21
float utStop = na
utStop := na(utStop[1]) ? close : close > utStop[1] and close[1] > utStop[1] ? math.max(utStop[1], close - utNloss) : close < utStop[1] and close[1] < utStop[1] ? math.min(utStop[1], close + utNloss) : close > utStop[1] ? close - utNloss : close + utNloss
utFlipUp   = not na(utStop[1]) and close > utStop and close[1] <= utStop[1]
utFlipDown = not na(utStop[1]) and close < utStop and close[1] >= utStop[1]

// Candle anatomy of the confirmed bar (== EA Bar[1])
body1      = math.abs(close - open)
body2      = math.abs(close[1] - open[1])
range1     = math.max(high - low, tickSize)
lowerWick  = math.min(open, close) - low
upperWick  = high - math.max(open, close)
bullCQ     = close > open and (high - close) <= 0.45 * range1
bearCQ     = close < open and (close - low)  <= 0.45 * range1

// Structural swings — MQL iHighest/iLowest shifts translated to Pine offsets
swHigh4    = ta.highest(high[1], 4)         // EA bars 2..5
swLow4     = ta.lowest(low[1], 4)
indHigh10  = ta.highest(high[2], 10)        // EA bars 3..12
indLow10   = ta.lowest(low[2], 10)
extHigh20  = ta.highest(high[3], 20)        // EA bars 4..23
extLow20   = ta.lowest(low[3], 20)
prevLow3   = ta.lowest(low[1], 3)           // EA bars 2..4
prevHigh3  = ta.highest(high[1], 3)
recentLow3 = ta.lowest(low, 3)              // EA bars 1..3
recentHigh3 = ta.highest(high, 3)
fallbackHi = ta.highest(high[1], 32)
fallbackLo = ta.lowest(low[1], 32)

// Fair Value Gaps
bullFvg = (low > high[2] and close[1] > open[1]) or (low[1] > high[3] and close[2] > open[2])
bearFvg = (high < low[2] and close[1] < open[1]) or (high[1] < low[3] and close[2] < open[2])

// Clock of the NEXT bar (the EA reads Time[0] when it decides) — global scope so the
// Engine-4 detector can receive the real trend bias exactly like the MQL call does.
int   tNextG   = time_close
float brkNextG = f_brokerHour(tNextG)
int   hrNextG  = math.floor(brkNextG)
int   minNextG = math.round((brkNextG - hrNextG) * 60)
if minNextG >= 60
    hrNextG  := hrNextG + 1
    minNextG := minNextG - 60
if hrNextG >= 24
    hrNextG := hrNextG - 24
bool isLateBuyG = pSkipLate and ((hrNextG == 18 and minNextG >= 15) or (hrNextG == 20 and minNextG >= 35))

// Strict M15 trend + slope engine (identical to section 4 of the MQL source)
bool bullBiasG = close > ema200 and ema50 > ema200 and not isLateBuyG
bool bearBiasG = close < ema200 and ema50 < ema200
if pStrictEma
    bullBiasG := bullBiasG and ema50 >= ema50p4 - 0.10 * atr1 and ema200 >= ema200p8 - 0.10 * atr1
    bearBiasG := bearBiasG and ema50 <= ema50p4 + 0.10 * atr1 and ema200 <= ema200p8 + 0.10 * atr1

// Engine 4 runs unconditionally (pure function) — the result is only *used* when the
// EA's own gate would have allowed it, which keeps behaviour identical.
[sp2lDir, sp2lExtreme, sp2lTime] = f_sp2l(bullBiasG, bearBiasG, bullCQ, bearCQ, atr21, lastSpikeTime)
pbVote = f_pbVote(ema50, ema200)

// Session shading flags — pure clock maths on the bar's own open time, so they are
// available for the forming bar too and can never repaint.
brkSelf     = f_brokerHour(time)
nySelf      = f_nyHour(time)
inNyAmBar   = brkSelf >= nyAmStart and brkSelf <= nyAmEnd
inNyPmBar   = brkSelf >= nyPmStart and brkSelf <= nyPmEnd
inPreNyBar  = enablePreNy and brkSelf >= preNyStart and brkSelf <= preNyEnd
inLonBar    = pLondon and brkSelf >= lonStart and brkSelf <= lonEnd
inTrackBar  = (pLondon and brkSelf >= lonStart - 0.5 and brkSelf <= lonEnd) or (enablePreNy and brkSelf >= preNyStart - 0.5 and brkSelf <= trackEnd) or (brkSelf >= trackStart and brkSelf <= trackEnd)
whipBarNow  = pSkipWhip and ((math.floor(brkSelf) == 16 and math.round((brkSelf - math.floor(brkSelf)) * 60) == 45) or (math.floor(brkSelf) == 17 and math.round((brkSelf - math.floor(brkSelf)) * 60) == 45))
lateBuyBar  = pSkipLate and ((math.floor(brkSelf) == 18 and math.round((brkSelf - math.floor(brkSelf)) * 60) >= 15) or (math.floor(brkSelf) == 20 and math.round((brkSelf - math.floor(brkSelf)) * 60) >= 35))

// Display exports consumed by the plot / table layer (persist between bars)
var bool   inNyAmOut      = false
var bool   inNyPmOut      = false
var bool   inPreNyOut     = false
var bool   inLonOut       = false
var bool   inTrackOut     = false
var string activeWindowOut = "—"
var bool   bullBiasOut    = false
var bool   bearBiasOut    = false
var int    stageOut       = 0
var bool   utAllowOut     = true
var bool   bbAllowOut     = true
var bool   shieldFired    = false
int    rawDirOut      = 0
string rawWhyOut      = ""
string rawEngineOut   = ""
int    pbVoteOut      = 0

// ═══════════════════════════════════════════════════════════════════════════
//  MAIN STATE MACHINE — one pass per CLOSED bar (zero repaint)
//  The MQL OnTick() bails out with `if(Bars < 250) return;` before anything else —
//  the same warm-up floor is applied here (EMA200 needs it anyway).
// ═══════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed and bar_index >= 250
    // unified exit / partial request flags (set by A3 or by the reversal shield)
    bool   exitNow       = false
    float  exitPx        = na
    string exitWhy       = ""
    bool   takePartialNow = false
    float  partialPx     = na
    int    stagedNow     = 0

    // per-bar increment (EA: g_bars_since_entry++ on every new bar)
    barsSinceEntry := barsSinceEntry + 1

    // ── clock context ──
    float brkBar  = f_brokerHour(time)          // this closed bar  (EA Bar[1])
    float nyBar   = f_nyHour(time)
    int   tNext   = time_close                  // next bar open     (EA Time[0])
    float brkNext = f_brokerHour(tNext)
    int   hrInt   = math.floor(brkNext)
    int   minInt  = math.round((brkNext - hrInt) * 60)
    if minInt >= 60
        hrInt  := hrInt + 1
        minInt := minInt - 60
    hrInt  := hrInt >= 24 ? hrInt - 24 : hrInt

    // ── day rollover + session liquidity (UpdateSessionLiquidityLevels) ──
    int dk = f_dayKey(time)
    newDay := not na(curDayKey) and dk != curDayKey
    if na(curDayKey)
        curDayKey    := dk
        asianHigh    := high
        asianLow     := low
        londonHigh   := high
        londonLow    := low
        dayHigh      := high
        dayLow       := low
        midnightOpen := open
    if newDay
        float prevRange = dayHigh - dayLow
        if prevRange > atr1 * 1.5
            pdh := dayHigh
            pdl := dayLow
        curDayKey      := dk
        asianHigh      := 0.0
        asianLow       := 1e9
        londonHigh     := 0.0
        londonLow      := 1e9
        midnightOpen   := 0.0
        dayHigh        := high
        dayLow         := low
        lonTradesC     := 0
        preNyTradesC   := 0
        nyAmTradesC    := 0
        nyPmTradesC    := 0
        bullSweepActive := false
        bearSweepActive := false
    dayHigh := math.max(dayHigh, high)
    dayLow  := math.min(dayLow, low)
    if nyBar >= 18.0 or nyBar < 2.0
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    if nyBar >= 0.0 and nyBar < 2.0 and midnightOpen == 0.0
        midnightOpen := open
    if nyBar >= 2.0 and nyBar < 7.0
        londonHigh := math.max(londonHigh, high)
        londonLow  := math.min(londonLow, low)
    if asianHigh <= 0 or asianLow >= 1e8
        asianHigh := fallbackHi
        asianLow  := fallbackLo

    // ═══════════════ PHASE A · execution of the previous bar's intent ═══════
    // (the EA sends its order on the first tick of the NEXT bar)
    if intentDir != 0 and not na(intentBar) and intentBar < bar_index - 1
        intentDir := 0
    if intentDir != 0 and intentBar == bar_index - 1
        int   dir   = intentDir
        float manip = intentExtreme
        float atrI  = nz(intentAtr, atr1)
        float legSz = math.abs(close[1] - manip)
        float limPx = close[1] - dir * pPullback * legSz
        bool  useLim = not pMarketEntry
        // MQL: limit is rejected when it is not far enough from Ask (BUY) / Bid (SELL)
        if useLim and dir == 1 and limPx >= open + spreadPrice
            useLim := false
        if useLim and dir == -1 and limPx <= open
            useLim := false
        float refEntry = useLim ? limPx : dir == 1 ? open + spreadPrice : open
        float slPx     = dir == 1 ? manip - pSlBuf * atrI - spreadPrice : manip + pSlBuf * atrI + spreadPrice
        float riskDist = math.abs(refEntry - slPx)
        float minSl    = math.max(open * pMinSlPct / 100.0, spreadPrice * 2.0 + tickSize)
        float maxSl    = open * pMaxSlPct / 100.0
        bool  aborted  = false
        if riskDist < minSl
            riskDist := minSl
            slPx     := refEntry - dir * riskDist
        if riskDist > maxSl or riskDist <= 0
            aborted := true
            bullSweepActive := false
            bearSweepActive := false
        if not aborted
            float tpPx = refEntry + dir * pRrTarget * riskDist
            float lots = f_calcLots(riskDist, balance)
            if useLim
                pendDir        := dir
                pendPrice      := limPx
                pendSL         := slPx
                pendTP         := tpPx
                pendLots       := lots
                pendRisk       := riskDist
                pendInval      := manip
                pendCreatedBar := bar_index
                pendCreatedTim := time
                pendEngine     := intentEngine
                pendWindow     := intentWindow
                pendStartBal   := balance
                barsSinceEntry := 0
                if pendWindow == "LON10"
                    lonTradesC := lonTradesC + 1
                if pendWindow == "PRE_NY"
                    preNyTradesC := preNyTradesC + 1
                if pendWindow == "NY_AM"
                    nyAmTradesC := nyAmTradesC + 1
                if pendWindow == "NY_PM"
                    nyPmTradesC := nyPmTradesC + 1
                if intentEngine != "GF_SP2L"
                    bullSweepActive := false
                    bearSweepActive := false
                if intentEngine == "GF_SP2L" and not na(intentSpike)
                    lastSpikeTime := intentSpike
                if showPending
                    pendLine   := line.new(time, limPx, time, limPx, xloc.bar_time, extend.right, color.new(color.orange, 0), line.style_solid, 2)
                    pendSlLine := line.new(time, slPx, time, slPx, xloc.bar_time, extend.right, color.new(color.red, 30), line.style_dotted, 1)
                    pendTpLine := line.new(time, tpPx, time, tpPx, xloc.bar_time, extend.right, color.new(color.green, 30), line.style_dotted, 1)
                    pendLbl    := label.new(time, limPx, "⏳ " + intentEngine + " " + (dir > 0 ? "BUY" : "SELL") + " LIMIT " + f_px(limPx) + "\n" + f_lots(lots) + " · SL " + f_px(slPx) + " · TP " + f_px(tpPx) + "\n" + intentWindow + " · expires in " + str.tostring(pExpiry + 1) + " bar(s)", xloc.bar_time, yloc.price, color.new(color.orange, 78), label.style_label_left, color.orange, lblSz)
                lastEvent := "LIMIT PLACED " + intentEngine + " " + intentWindow
                // same-bar fill (the limit can be hit later inside this very bar)
                bool filled = dir == 1 ? low <= limPx : high >= limPx
                bool inval  = dir == 1 ? low <= pendInval : high >= pendInval
                if filled
                    posDir       := dir
                    posEntry     := limPx
                    posSL        := slPx
                    posTP        := tpPx
                    posLots      := lots
                    posInitLots  := lots
                    posRisk      := riskDist
                    posRealized  := 0.0
                    posPartLots  := 0.0
                    posPartDone  := false
                    posStep      := 0
                    posEngine    := pendEngine
                    posWindow    := pendWindow
                    posEntryTime := time
                    posStartBal  := balance
                    posId        := posId + 1
                    pendDir      := 0
                    if showPending
                        line.delete(pendLine)
                        line.delete(pendSlLine)
                        line.delete(pendTpLine)
                        label.delete(pendLbl)
                        pendLine   := na
                        pendSlLine := na
                        pendTpLine := na
                        pendLbl    := na
                    evEntry   := true
                    lastEvent := "FILLED " + posEngine + " " + posWindow
                else if inval
                    pendDir := 0
                    expiredPendings := expiredPendings + 1
                    if pendWindow == "NY_AM" and nyAmTradesC > 0
                        nyAmTradesC := nyAmTradesC - 1
                    if pendWindow == "NY_PM" and nyPmTradesC > 0
                        nyPmTradesC := nyPmTradesC - 1
                    if pendWindow == "PRE_NY" and preNyTradesC > 0
                        preNyTradesC := preNyTradesC - 1
                    if pendWindow == "LON10" and lonTradesC > 0
                        lonTradesC := lonTradesC - 1
                    if showPending
                        line.delete(pendLine)
                        line.delete(pendSlLine)
                        line.delete(pendTpLine)
                        label.delete(pendLbl)
                        pendLine   := na
                        pendSlLine := na
                        pendTpLine := na
                        pendLbl    := na
                    lastEvent := "PENDING INVALIDATED"
            else
                // market execution at the open of this bar
                posDir       := dir
                posEntry     := refEntry
                posSL        := slPx
                posTP        := tpPx
                posLots      := lots
                posInitLots  := lots
                posRisk      := riskDist
                posRealized  := 0.0
                posPartLots  := 0.0
                posPartDone  := false
                posStep      := 0
                posEngine    := intentEngine
                posWindow    := intentWindow
                posEntryTime := time
                posStartBal  := balance
                posId        := posId + 1
                barsSinceEntry := 0
                if posWindow == "LON10"
                    lonTradesC := lonTradesC + 1
                if posWindow == "PRE_NY"
                    preNyTradesC := preNyTradesC + 1
                if posWindow == "NY_AM"
                    nyAmTradesC := nyAmTradesC + 1
                if posWindow == "NY_PM"
                    nyPmTradesC := nyPmTradesC + 1
                if intentEngine != "GF_SP2L"
                    bullSweepActive := false
                    bearSweepActive := false
                if intentEngine == "GF_SP2L" and not na(intentSpike)
                    lastSpikeTime := intentSpike
                evEntry   := true
                lastEvent := "MARKET " + (dir > 0 ? "BUY" : "SELL") + " " + intentEngine + " " + intentWindow
        intentDir := 0

    // ═══════════════ PHASE A2 · pending limit management ═══════════════════
    if pendDir != 0 and bar_index > pendCreatedBar
        int  alive = bar_index - pendCreatedBar
        bool eod   = closeAtNyEnd and ((nyBar >= 16.0 and nyBar < 18.0) or brkBar >= 22.85)
        bool filled = pendDir == 1 ? low <= pendPrice : high >= pendPrice
        bool inval  = pendDir == 1 ? low <= pendInval : high >= pendInval
        if alive > pExpiry or eod or (inval and not filled)
            expiredPendings := expiredPendings + 1
            if pendWindow == "NY_AM" and nyAmTradesC > 0
                nyAmTradesC := nyAmTradesC - 1
            if pendWindow == "NY_PM" and nyPmTradesC > 0
                nyPmTradesC := nyPmTradesC - 1
            if pendWindow == "PRE_NY" and preNyTradesC > 0
                preNyTradesC := preNyTradesC - 1
            if pendWindow == "LON10" and lonTradesC > 0
                lonTradesC := lonTradesC - 1
            if showPending
                line.delete(pendLine)
                line.delete(pendSlLine)
                line.delete(pendTpLine)
                label.delete(pendLbl)
                pendLine   := na
                pendSlLine := na
                pendTpLine := na
                pendLbl    := na
            pendDir   := 0
            lastEvent := eod ? "PENDING CLOSED (EOD)" : alive > pExpiry ? "PENDING EXPIRED" : "PENDING INVALIDATED"
        else if filled
            posDir       := pendDir
            posEntry     := pendPrice
            posSL        := pendSL
            posTP        := pendTP
            posLots      := pendLots
            posInitLots  := pendLots
            posRisk      := pendRisk
            posRealized  := 0.0
            posPartLots  := 0.0
            posPartDone  := false
            posStep      := 0
            posEngine    := pendEngine
            posWindow    := pendWindow
            posEntryTime := time
            posStartBal  := pendStartBal
            posId        := posId + 1
            pendDir      := 0
            if showPending
                line.delete(pendLine)
                line.delete(pendSlLine)
                line.delete(pendTpLine)
                label.delete(pendLbl)
                pendLine   := na
                pendSlLine := na
                pendTpLine := na
                pendLbl    := na
            evEntry   := true
            lastEvent := "FILLED " + posEngine + " " + posWindow

    // ═══════════════ PHASE A3 · open-position management ═══════════════════
    // 3-stage Step-Lock ladder + SL/TP resolution (ManageOpenPositions)
    if posDir != 0
        bool  sameBar = posEntryTime == time
        bool  canExit = not (sameBar and noSameBar)
        float sl0     = posSL
        float tp0     = posTP
        int   stage   = 0
        float newSL   = sl0
        float s1t     = na
        float s1l     = na
        float s2t     = na
        float s2l     = na
        float s3t     = na
        float s3l     = na
        if useStepLock and posRisk > 0
            if posDir == 1
                s1t := posEntry + trigStep1 * posRisk
                s1l := posEntry + lockStep1 * posRisk
                s2t := posEntry + trigStep2 * posRisk
                s2l := posEntry + lockStep2 * posRisk
                s3t := posEntry + trigStep3 * posRisk
                s3l := posEntry + lockStep3 * posRisk
                stage := high >= s3t ? 3 : high >= s2t ? 2 : high >= s1t ? 1 : 0
                newSL := stage == 3 ? math.max(sl0, s3l) : stage == 2 ? math.max(sl0, s2l) : stage == 1 ? math.max(sl0, s1l) : sl0
            else
                s1t := posEntry - trigStep1 * posRisk
                s1l := posEntry - lockStep1 * posRisk
                s2t := posEntry - trigStep2 * posRisk
                s2l := posEntry - lockStep2 * posRisk
                s3t := posEntry - trigStep3 * posRisk
                s3l := posEntry - lockStep3 * posRisk
                stage := low <= s3t ? 3 : low <= s2t ? 2 : low <= s1t ? 1 : 0
                newSL := stage == 3 ? math.min(sl0, s3l) : stage == 2 ? math.min(sl0, s2l) : stage == 1 ? math.min(sl0, s1l) : sl0
        bool hitSlOrig   = posDir == 1 ? low <= sl0 : high >= sl0
        bool hitTp       = posDir == 1 ? high >= tp0 : low <= tp0
        bool hitNewSl    = stage > 0 and (posDir == 1 ? low <= newSL : high >= newSL)
        bool wantPartial = usePartial and useStepLock and stage >= 1 and not posPartDone and not na(s1t)
        bool eodClose    = closeAtNyEnd and ((nyBar >= 16.0 and nyBar < 18.0) or brkBar >= 22.85)

        if eodClose
            exitNow := true
            exitPx  := close
            exitWhy := "SESSION_END"
        else if canExit and (pessimistic or noSameBar)
            if hitSlOrig
                exitNow := true
                exitPx  := sl0
                exitWhy := posStep > 0 ? "LOCK" : "SL"
            else if hitNewSl
                takePartialNow := wantPartial
                partialPx      := s1t
                posStep        := math.max(posStep, stage)
                stagedNow      := stage
                exitNow        := true
                exitPx         := newSL
                exitWhy        := "LOCK"
            else if hitTp
                takePartialNow := wantPartial
                partialPx      := s1t
                exitNow        := true
                exitPx         := tp0
                exitWhy        := "TP"
            else
                takePartialNow := wantPartial
                partialPx      := s1t
                if stage > 0
                    posSL   := newSL
                    posStep := math.max(posStep, stage)
                    stagedNow := stage
        else if canExit and optimistic
            if hitTp
                takePartialNow := wantPartial
                partialPx      := s1t
                exitNow        := true
                exitPx         := tp0
                exitWhy        := "TP"
            else if hitNewSl
                takePartialNow := wantPartial
                partialPx      := s1t
                posStep        := math.max(posStep, stage)
                stagedNow      := stage
                exitNow        := true
                exitPx         := newSL
                exitWhy        := "LOCK"
            else if hitSlOrig
                exitNow := true
                exitPx  := sl0
                exitWhy := posStep > 0 ? "LOCK" : "SL"
            else
                takePartialNow := wantPartial
                partialPx      := s1t
                if stage > 0
                    posSL   := newSL
                    posStep := math.max(posStep, stage)
                    stagedNow := stage

        // keep the live ladder glued to the current bar
        if showTradeLevels
            if sameBar and na(entryLine)
                color ec = posDir == 1 ? color.new(#2962FF, 0) : color.new(#FF1744, 0)
                entryLine := line.new(posEntryTime, posEntry, time, posEntry, xloc.bar_time, extend.right, color.new(ec, 20), line.style_solid, 2)
                slLine    := line.new(posEntryTime, posSL, time, posSL, xloc.bar_time, extend.right, color.new(color.red, 10), line.style_dashed, 1)
                tpLine    := line.new(posEntryTime, posTP, time, posTP, xloc.bar_time, extend.right, color.new(color.green, 10), line.style_dashed, 1)
                string etxt = (posDir == 1 ? "▲ " : "▼ ") + posEngine + " · " + posWindow + "\n" + (posDir == 1 ? "BUY " : "SELL ") + f_lots(posInitLots) + " @ " + f_px(posEntry) + "\nSL " + f_px(posSL) + "  (-1.00R)\nTP " + f_px(posTP) + "  (+" + str.tostring(pRrTarget, "#.##") + "R)"
                label.new(posEntryTime, posEntry, etxt, xloc.bar_time, posDir == 1 ? yloc.belowprice : yloc.aboveprice, color.new(ec, 80), posDir == 1 ? label.style_label_up : label.style_label_down, ec, lblSz)
            if not na(slLine)
                line.set_xy1(slLine, posEntryTime, posSL)
                line.set_xy2(slLine, time, posSL)
            if not na(tpLine)
                line.set_xy1(tpLine, posEntryTime, posTP)
                line.set_xy2(tpLine, time, posTP)
            if not na(entryLine)
                line.set_xy2(entryLine, time, posEntry)
            if showStepLocks and useStepLock and posRisk > 0
                float a1 = posEntry + posDir * lockStep1 * posRisk
                float a2 = posEntry + posDir * lockStep2 * posRisk
                float a3 = posEntry + posDir * lockStep3 * posRisk
                if na(s1Line)
                    s1Line := line.new(posEntryTime, a1, time, a1, xloc.bar_time, extend.none, color.new(color.teal, 45), line.style_dotted, 1)
                    s2Line := line.new(posEntryTime, a2, time, a2, xloc.bar_time, extend.none, color.new(color.teal, 30), line.style_dotted, 1)
                    s3Line := line.new(posEntryTime, a3, time, a3, xloc.bar_time, extend.none, color.new(color.teal, 15), line.style_dotted, 1)
                else
                    line.set_xy1(s1Line, posEntryTime, a1)
                    line.set_xy2(s1Line, time, a1)
                    line.set_xy1(s2Line, posEntryTime, a2)
                    line.set_xy2(s2Line, time, a2)
                    line.set_xy1(s3Line, posEntryTime, a3)
                    line.set_xy2(s3Line, time, a3)

    bullBiasOut := bullBiasG
    bearBiasOut := bearBiasG
    pbVoteOut   := pbVote
    utAllowOut  := f_utAllow(1, close, utStop)
    bbAllowOut  := f_bbAllow(1, close, bbBasis, bbBasis1)

    // ═══════════════ PHASE C1 · micro-killzone windows ═════════════════════
    // The EA reads Time[0] (the bar that is just opening) → Pine `time_close`.
    bool isWhipBar = pSkipWhip and ((hrInt == 16 and minInt == 45) or (hrInt == 17 and minInt == 45))
    bool isLateBuy = pSkipLate and ((hrInt == 18 and minInt >= 15) or (hrInt == 20 and minInt >= 35))
    bool inLon10   = pLondon and brkNext >= lonStart and brkNext <= lonEnd
    bool inPreNy   = enablePreNy and brkNext >= preNyStart and brkNext <= preNyEnd
    bool inNyAm    = brkNext >= nyAmStart and brkNext <= nyAmEnd and not isWhipBar
    bool inNyPm    = brkNext >= nyPmStart and brkNext <= nyPmEnd
    string activeWindow = ""
    if inNyAm and nyAmTradesC < pMaxNyAm
        activeWindow := "NY_AM"
    else if inNyPm and nyPmTradesC < pMaxNyPm
        activeWindow := "NY_PM"
    else if inPreNy and preNyTradesC < maxTradesPreNy
        activeWindow := "PRE_NY"
    else if inLon10 and lonTradesC < 1
        activeWindow := "LON10"
    bool inTrack = (pLondon and brkNext >= lonStart - 0.5 and brkNext <= lonEnd) or (enablePreNy and brkNext >= preNyStart - 0.5 and brkNext <= trackEnd) or (brkNext >= trackStart and brkNext <= trackEnd)
    inNyAmOut      := inNyAm
    inNyPmOut      := inNyPm
    inPreNyOut     := inPreNy
    inLonOut       := inLon10
    inTrackOut     := inTrack
    activeWindowOut := activeWindow == "" ? "—" : activeWindow
    if not inTrack
        bullSweepActive := false
        bearSweepActive := false

    // ═══════════════ PHASE C2 · AMD liquidity-sweep state machine ══════════
    float sweepMin = pMinSweep * atr1
    float sweepMax = pMaxSweep * atr1
    if inTrack
        array<float> ssl = array.from(asianLow, pdl, extLow20, indLow10, swLow4, londonLow < 1e8 and londonLow > 0 ? londonLow : asianLow)
        array<float> bsl = array.from(asianHigh, pdh, extHigh20, indHigh10, swHigh4, londonHigh > 0 ? londonHigh : asianHigh)
        if bullSweepActive
            bullSweepBars := bullSweepBars + 1
            bullManipLow  := math.min(bullManipLow, low)
            if bullSweepBars > pMaxMss or (bullSweptLevel - bullManipLow) > sweepMax
                bullSweepActive := false
        if not bullSweepActive
            for p = 0 to 5
                float pool = array.get(ssl, p)
                if pool > 0 and pool < 1e8 and low <= pool - sweepMin and pool - low <= sweepMax
                    bullSweepActive := true
                    bullSweepBars   := 0
                    bullSweptLevel  := pool
                    bullManipLow    := low
                    bullSweepTime   := time
                    break
        if bearSweepActive
            bearSweepBars := bearSweepBars + 1
            bearManipHigh := math.max(bearManipHigh, high)
            if bearSweepBars > pMaxMss or (bearManipHigh - bearSweptLevel) > sweepMax
                bearSweepActive := false
        if not bearSweepActive
            for p = 0 to 5
                float pool = array.get(bsl, p)
                if pool > 0 and pool < 1e8 and high >= pool + sweepMin and high - pool <= sweepMax
                    bearSweepActive := true
                    bearSweepBars   := 0
                    bearSweptLevel  := pool
                    bearManipHigh   := high
                    bearSweepTime   := time
                    break

    if showSweepZones
        if bullSweepActive
            float topB = math.max(bullSweptLevel, bullManipLow)
            float botB = math.min(bullSweptLevel, bullManipLow)
            if na(bullSweepBx)
                bullSweepBx := box.new(nz(bullSweepTime, time), topB, time, botB, color.new(#26A69A, 45), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(#26A69A, 86))
                bullSweepLn := line.new(nz(bullSweepTime, time), bullSweptLevel, time, bullSweptLevel, xloc.bar_time, extend.right, color.new(#26A69A, 25), line.style_dashed, 1)
                label.new(nz(bullSweepTime, time), botB, "SSL SWEPT\n" + f_px(bullSweptLevel), xloc.bar_time, yloc.belowprice, color.new(#26A69A, 75), label.style_label_up, color.white, size.tiny)
            else
                box.set_right(bullSweepBx, time)
                box.set_bottom(bullSweepBx, botB)
                line.set_x2(bullSweepLn, time)
        else if not na(bullSweepBx)
            box.set_right(bullSweepBx, time)
            line.set_x2(bullSweepLn, time)
            line.set_extend(bullSweepLn, extend.none)
            bullSweepBx := na
            bullSweepLn := na
        if bearSweepActive
            float topR = math.max(bearSweptLevel, bearManipHigh)
            float botR = math.min(bearSweptLevel, bearManipHigh)
            if na(bearSweepBx)
                bearSweepBx := box.new(nz(bearSweepTime, time), topR, time, botR, color.new(#FF5252, 45), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(#FF5252, 86))
                bearSweepLn := line.new(nz(bearSweepTime, time), bearSweptLevel, time, bearSweptLevel, xloc.bar_time, extend.right, color.new(#FF5252, 25), line.style_dashed, 1)
                label.new(nz(bearSweepTime, time), topR, "BSL SWEPT\n" + f_px(bearSweptLevel), xloc.bar_time, yloc.aboveprice, color.new(#FF5252, 75), label.style_label_down, color.white, size.tiny)
            else
                box.set_right(bearSweepBx, time)
                box.set_top(bearSweepBx, topR)
                line.set_x2(bearSweepLn, time)
        else if not na(bearSweepBx)
            box.set_right(bearSweepBx, time)
            line.set_x2(bearSweepLn, time)
            line.set_extend(bearSweepLn, extend.none)
            bearSweepBx := na
            bearSweepLn := na

    // ═══════════════ PHASE C3 · pre-Step1 reversal-quorum shield ═══════════
    shieldFired := false
    if inTrack and useShield and posDir != 0 and not exitNow and pbVote != 0
        int votes = 1
        if posDir == 1 and pbVote == -1
            if bearSweepActive
                votes := votes + 1
            if f_utAllow(-1, close, utStop)
                votes := votes + 1
            if f_bbAllow(-1, close, bbBasis, bbBasis1)
                votes := votes + 1
            if votes >= 3 and posSL < posEntry and close < posEntry
                exitNow     := true
                exitPx      := close
                exitWhy     := "SHIELD"
                shieldFired := true
                evShield    := true
                lastEvent   := "SHIELD EXIT (quorum " + str.tostring(votes) + "/4)"
        if posDir == -1 and pbVote == 1
            if bullSweepActive
                votes := votes + 1
            if f_utAllow(1, close, utStop)
                votes := votes + 1
            if f_bbAllow(1, close, bbBasis, bbBasis1)
                votes := votes + 1
            if votes >= 3 and (posSL > posEntry or posSL == 0) and close > posEntry
                exitNow     := true
                exitPx      := close
                exitWhy     := "SHIELD"
                shieldFired := true
                evShield    := true
                lastEvent   := "SHIELD EXIT (quorum " + str.tostring(votes) + "/4)"

    // ═══════════════ LEDGER · partial close + trade close ══════════════════
    if posDir != 0 and takePartialNow and not posPartDone and not na(partialPx)
        float partLots = f_normLots(posLots * partialPct / 100.0)
        if partLots >= minLotIn and posLots - partLots >= minLotIn
            posRealized := posRealized + (partialPx - posEntry) * posDir * partLots * contractSize
            posPartLots := posPartLots + partLots
            posLots     := posLots - partLots
            posPartDone := true
            partialCount := partialCount + 1
            evPartial   := true
            if showTradeLevels
                label.new(time, partialPx, "◑ " + str.tostring(partialPct, "#") + "% @" + f_px(partialPx) + "\n+" + f_money((partialPx - posEntry) * posDir * partLots * contractSize), xloc.bar_time, posDir == 1 ? yloc.aboveprice : yloc.belowprice, color.new(color.teal, 78), posDir == 1 ? label.style_label_down : label.style_label_up, color.new(color.teal, 0), size.tiny)
    if exitNow and posDir != 0 and not na(exitPx)
        float grossExit = (exitPx - posEntry) * posDir * posLots * contractSize
        float commExit  = commissionPerLot * (posLots + posPartLots)
        float pnlExit   = posRealized + grossExit - commExit
        float riskDollars = posRisk * posInitLots * contractSize
        float rMult     = riskDollars > 0 ? pnlExit / riskDollars : 0.0
        trades    := trades + 1
        netProfit := netProfit + pnlExit
        balance   := balance + pnlExit
        sumR      := sumR + rMult
        bestR     := math.max(bestR, rMult)
        worstR    := math.min(worstR, rMult)
        if pnlExit > 0
            wins        := wins + 1
            grossProfit := grossProfit + pnlExit
            sumWinR     := sumWinR + rMult
            consecWin   := consecWin + 1
            consecLoss  := 0
            maxConsecWin := math.max(maxConsecWin, consecWin)
        else
            losses    := losses + 1
            grossLoss := grossLoss + math.abs(pnlExit)
            sumLossR  := sumLossR + rMult
            consecLoss := consecLoss + 1
            consecWin  := 0
            maxConsecLoss := math.max(maxConsecLoss, consecLoss)
            barsSinceEntry := pCooldown - postLossCooldown
        if exitWhy == "TP"
            tpHits := tpHits + 1
        else if exitWhy == "SL"
            slHits := slHits + 1
        else if exitWhy == "LOCK"
            lockExits := lockExits + 1
        else if exitWhy == "SHIELD"
            shieldExits := shieldExits + 1
        else if exitWhy == "SESSION_END"
            sessionExits := sessionExits + 1
        int ei = f_engIdx(posEngine)
        int wi = f_winIdx(posWindow)
        array.set(engTrades, ei, array.get(engTrades, ei) + 1)
        array.set(engPnl, ei, array.get(engPnl, ei) + pnlExit)
        array.set(winTrades, wi, array.get(winTrades, wi) + 1)
        array.set(winPnl, wi, array.get(winPnl, wi) + pnlExit)
        if pnlExit > 0
            array.set(engWins, ei, array.get(engWins, ei) + 1)
            array.set(winWins, wi, array.get(winWins, wi) + 1)
        if posDir == 1
            buyTrades := buyTrades + 1
            buyPnl    := buyPnl + pnlExit
            if pnlExit > 0
                buyWins := buyWins + 1
        else
            sellTrades := sellTrades + 1
            sellPnl    := sellPnl + pnlExit
            if pnlExit > 0
                sellWins := sellWins + 1
        peakBalance   := math.max(peakBalance, balance)
        float ddNow   = peakBalance - balance
        maxDrawdown   := math.max(maxDrawdown, ddNow)
        maxDrawdownPct := math.max(maxDrawdownPct, peakBalance > 0 ? ddNow / peakBalance * 100.0 : 0.0)
        // exit artwork
        color xc = pnlExit > 0 ? color.new(#00E676, 0) : color.new(#FF1744, 0)
        string xtxt = exitWhy + "  " + f_r(rMult) + "\n" + f_money(pnlExit) + (posPartDone ? "\n(+" + str.tostring(partialPct, "#") + "% partial)" : "")
        if showTradeLevels or showTradeZones
            label.new(time, exitPx, xtxt, xloc.bar_time, posDir == 1 ? yloc.aboveprice : yloc.belowprice, color.new(xc, 72), posDir == 1 ? label.style_label_down : label.style_label_up, xc, lblSz)
        if showTradeZones and not na(posEntryTime)
            float zTop = math.max(posEntry, exitPx)
            float zBot = math.min(posEntry, exitPx)
            if zTop - zBot < atr1 * 0.35
                zTop := zTop + atr1 * 0.175
                zBot := zBot - atr1 * 0.175
            int zRight = time > posEntryTime ? time : time + timeframe.in_seconds(timeframe.period) * 1000
            box.new(posEntryTime, zTop, zRight, zBot, color.new(xc, 55), 1, line.style_solid, extend.none, xloc.bar_time, color.new(xc, 90))
        if showTradeLevels
            if not na(slLine)
                line.set_x2(slLine, time)
                line.set_extend(slLine, extend.none)
            if not na(tpLine)
                line.set_x2(tpLine, time)
                line.set_extend(tpLine, extend.none)
            if not na(entryLine)
                line.set_x2(entryLine, time)
                line.set_extend(entryLine, extend.none)
            if not na(s1Line)
                line.delete(s1Line)
            if not na(s2Line)
                line.delete(s2Line)
            if not na(s3Line)
                line.delete(s3Line)
            s1Line := na
            s2Line := na
            s3Line := na
            slLine    := na
            tpLine    := na
            entryLine := na
        // reset the position
        posDir      := 0
        posEntry    := na
        posSL       := na
        posTP       := na
        posLots     := na
        posInitLots := na
        posRisk     := na
        posRealized := 0.0
        posPartLots := 0.0
        posPartDone := false
        posStep     := 0
        posEngine   := ""
        posWindow   := ""
        posEntryTime := na
        posStartBal := na
        evExit       := true
        lastTradeR   := rMult
        lastTradePnl := pnlExit
        lastExitPrice := exitPx
        lastExitWhy  := exitWhy
        if not shieldFired
            lastEvent := exitWhy + " " + f_r(rMult) + " " + f_money(pnlExit)
    stageOut := posStep

    // ═══════════════ PHASE C5 · the four entry engines ═════════════════════
    bool isPreNyWin = activeWindow == "PRE_NY"
    int    sigDir     = 0
    float  sigExtreme = na
    string sigEngine  = ""
    int    sigSpike   = na

    // ── ENGINE 1 · classic AMD liquidity sweep + displacement + MSS ──
    if pEng1
        if bullSweepActive and bullBiasG and bullCQ and close > bullSweptLevel
            bool hasDisp = body1 >= pDispBody * atr1 or (body2 >= pDispBody * atr1p and close[1] > open[1])
            bool hasMss  = close >= swHigh4 - 0.20 * atr1 or bullFvg or close > high[1]
            if hasDisp and hasMss and f_gfAllow(1, isPreNyWin, close, utStop, bbBasis, bbBasis1)
                sigDir     := 1
                sigExtreme := math.min(bullManipLow, low)
                sigEngine  := "AMD"
        else if bearSweepActive and bearBiasG and bearCQ and close < bearSweptLevel
            bool hasDisp = body1 >= pDispBody * atr1 or (body2 >= pDispBody * atr1p and close[1] < open[1])
            bool hasMss  = close <= swLow4 + 0.20 * atr1 or bearFvg or close < low[1]
            if hasDisp and hasMss and f_gfAllow(-1, isPreNyWin, close, utStop, bbBasis, bbBasis1)
                sigDir     := -1
                sigExtreme := math.max(bearManipHigh, high)
                sigEngine  := "AMD"

    // ── ENGINE 2 · Layer-3 internal swing sweep / Turtle-Soup rejection ──
    if sigDir == 0 and pEng2
        if bullBiasG and close > ema50 and low < prevLow3 and close > prevLow3 and bullCQ
            if (lowerWick >= 0.30 * atr1 or body1 >= 0.30 * atr1) and (close > high[1] or bullFvg) and f_gfAllow(1, isPreNyWin, close, utStop, bbBasis, bbBasis1)
                sigDir     := 1
                sigExtreme := low
                sigEngine  := "L3_SWEEP"
        else if bearBiasG and close < ema50 and high > prevHigh3 and close < prevHigh3 and bearCQ
            if (upperWick >= 0.30 * atr1 or body1 >= 0.30 * atr1) and (close < low[1] or bearFvg) and f_gfAllow(-1, isPreNyWin, close, utStop, bbBasis, bbBasis1)
                sigDir     := -1
                sigExtreme := high
                sigEngine  := "L3_SWEEP"

    // ── ENGINE 3 · NY Silver Bullet FVG continuation ──
    if sigDir == 0 and pEng3
        if bullBiasG and close > ema20 and ema20 > ema50 and ema50 > ema50p4 and bullCQ and (bullFvg or close > high[1])
            if recentLow3 <= ema20 + 0.18 * atr1 and recentLow3 >= ema50 - 0.10 * atr1 and body1 >= pDispBody * atr1 and f_gfAllow(1, isPreNyWin, close, utStop, bbBasis, bbBasis1)
                sigDir     := 1
                sigExtreme := recentLow3
                sigEngine  := "SILVER_B"
        else if pSbSell and bearBiasG and close < ema20 and ema20 < ema50 and ema50 < ema50p4 and bearCQ and (bearFvg or close < low[1])
            if recentHigh3 >= ema20 - 0.18 * atr1 and recentHigh3 <= ema50 + 0.10 * atr1 and body1 >= pDispBody * atr1 and f_gfAllow(-1, isPreNyWin, close, utStop, bbBasis, bbBasis1)
                sigDir     := -1
                sigExtreme := recentHigh3
                sigEngine  := "SILVER_B"

    // ── ENGINE 4 · GoldFusion SP2L (NY_PM only by default: 80% WR / +$756) ──
    if sigDir == 0 and eng4On and (not sp2lNyPmOnly or activeWindow == "NY_PM")
        if sp2lDir != 0 and f_gfAllow(sp2lDir, true, close, utStop, bbBasis, bbBasis1)
            sigDir     := sp2lDir
            sigExtreme := sp2lExtreme
            sigSpike   := sp2lTime
            sigEngine  := "GF_SP2L"

    // ═══════════════ PHASE C6 · gate + order intent ════════════════════════
    bool gateOk = inTrack and activeWindow != "" and posDir == 0 and pendDir == 0 and barsSinceEntry >= pCooldown
    if sigDir != 0
        rawDirOut    := sigDir
        rawEngineOut := sigEngine
        rawWhyOut    := ""
    if gateOk and sigDir != 0 and not na(sigExtreme)
        intentDir     := sigDir
        intentExtreme := sigExtreme
        intentEngine  := sigEngine
        intentWindow  := activeWindow
        intentAtr     := atr1
        intentBar     := bar_index
        intentSpike   := sigSpike
        sigDirOut     := sigDir
        sigEngineOut  := sigEngine
        sigWindowOut  := activeWindow
        evSignal      := true
        lastEvent     := "SIGNAL " + sigEngine + " " + activeWindow + (sigDir > 0 ? " BUY" : " SELL")
        if showSignalMarks
            color sc = sigDir > 0 ? color.new(#00E5FF, 0) : color.new(#FFD740, 0)
            label.new(time, sigDir > 0 ? low - atr1 * 0.9 : high + atr1 * 0.9, (sigDir > 0 ? "▲ " : "▼ ") + sigEngine + "\n" + activeWindow, xloc.bar_time, sigDir > 0 ? yloc.belowprice : yloc.aboveprice, color.new(sc, 70), sigDir > 0 ? label.style_label_up : label.style_label_down, sc, lblSz)
    else if sigDir != 0
        rawWhyOut := not inTrack ? "outside sweep-tracking hours" : activeWindow == "" ? "no killzone window / cap reached" : posDir != 0 ? "position already open" : pendDir != 0 ? "pending order active" : barsSinceEntry < pCooldown ? "cooldown" : "risk out of bounds"
        if showSignalMarks
            label.new(time, sigDir > 0 ? low - atr1 * 0.55 : high + atr1 * 0.55, "⊘ " + sigEngine, xloc.bar_time, sigDir > 0 ? yloc.belowprice : yloc.aboveprice, color.new(color.gray, 78), sigDir > 0 ? label.style_label_up : label.style_label_down, color.new(color.gray, 20), size.tiny)

    // ── FVG artwork (only inside tradable hours, keeps the chart readable) ──
    if showFVG and inTrackBar
        if bullFvg
            float gTop = low > high[2] ? low : low[1]
            float gBot = low > high[2] ? high[2] : high[3]
            box.new(time[1], gTop, time[1] + fvgExtendBars * timeframe.in_seconds(timeframe.period) * 1000, gBot, color.new(#26A69A, 60), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(#26A69A, 88))
        if bearFvg
            float gTop = high < low[2] ? low[2] : low[3]
            float gBot = high < low[2] ? high : high[1]
            box.new(time[1], gTop, time[1] + fvgExtendBars * timeframe.in_seconds(timeframe.period) * 1000, gBot, color.new(#EF5350, 60), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(#EF5350, 88))

// ═══════════════════════════════════════════════════════════════════════════
//  APPROXIMATED FOOTPRINT  (redrawn only on the last bar → cheap & stable)
// ═══════════════════════════════════════════════════════════════════════════
// TradingView exposes ONE aggregate (tick) volume per bar, therefore:
//   • the bar volume is redistributed over `fpRows` price buckets following the
//     bar's OHLC travel path (open → far extreme → near extreme → close), which is
//     the standard volume-profile-by-path approximation;
//   • the buy/sell split per bucket is estimated from the Close-Location-Value plus
//     a directional tilt across the bar (`fpTilt`);
//   • POC = the highest-volume bucket, imbalances = diagonal bid/ask ratio ≥ `fpImbalance`.
// It is an ANALYTICAL APPROXIMATION of order flow — not exchange bid/ask data.
float fpCvd     = na
float fpLastDlt = na
float fpPocPx   = na
if showFootprint and barstate.islast and bar_index > fpBars + 3
    if array.size(fpBoxes) > 0
        for i = 0 to array.size(fpBoxes) - 1
            box.delete(array.get(fpBoxes, i))
    array.clear(fpBoxes)
    if array.size(fpLabels) > 0
        for i = 0 to array.size(fpLabels) - 1
            label.delete(array.get(fpLabels, i))
    array.clear(fpLabels)
    int R   = math.max(3, fpRows)
    int N   = math.max(3, math.min(fpBars, math.floor(460.0 / R)))
    int bMs = timeframe.in_seconds(timeframe.period) * 1000
    array<float> buyV  = array.new<float>(N * R, 0.0)
    array<float> sellV = array.new<float>(N * R, 0.0)
    array<float> totV  = array.new<float>(N * R, 0.0)
    array<int>   pocIx = array.new<int>(N, 0)
    float cvd = 0.0
    for b = 0 to N - 1
        float hi_ = high[b]
        float lo_ = low[b]
        float op_ = open[b]
        float cl_ = close[b]
        float vo_ = nz(volume[b])
        float rng = hi_ - lo_
        if rng > 0 and vo_ > fpMinVol
            float rowH = rng / R
            float clv  = math.max(-1.0, math.min(1.0, ((cl_ - lo_) - (hi_ - cl_)) / rng))
            float baseBuy = math.max(0.05, math.min(0.95, 0.5 + 0.35 * clv))
            float tiltSgn = cl_ >= op_ ? 1.0 : -1.0
            array<float> wts = array.new<float>(R, 0.0)
            float a1 = op_
            float a2 = cl_ >= op_ ? lo_ : hi_
            float a3 = cl_ >= op_ ? hi_ : lo_
            float a4 = cl_
            for seg = 0 to 2
                float p1 = seg == 0 ? a1 : seg == 1 ? a2 : a3
                float p2 = seg == 0 ? a2 : seg == 1 ? a3 : a4
                float sLo = math.min(p1, p2)
                float sHi = math.max(p1, p2)
                for r = 0 to R - 1
                    float rLo = lo_ + r * rowH
                    float rHi = rLo + rowH
                    float ov  = math.min(sHi, rHi) - math.max(sLo, rLo)
                    if ov > 0
                        array.set(wts, r, array.get(wts, r) + ov / rowH)
            float wSum = 0.0
            for r = 0 to R - 1
                wSum := wSum + array.get(wts, r)
            if wSum > 0
                float bestV = -1.0
                int   bestRow = 0
                for r = 0 to R - 1
                    float vRow = vo_ * array.get(wts, r) / wSum
                    float mid  = lo_ + (r + 0.5) * rowH
                    float tilt = fpTilt * ((mid - (hi_ + lo_) / 2.0) / rng) * tiltSgn
                    float bRat = math.max(0.0, math.min(1.0, baseBuy + tilt))
                    float bv   = vRow * bRat
                    array.set(buyV,  b * R + r, bv)
                    array.set(sellV, b * R + r, vRow - bv)
                    array.set(totV,  b * R + r, vRow)
                    if vRow > bestV
                        bestV := vRow
                        bestRow := r
                array.set(pocIx, b, bestRow)
                float colDelta = 0.0
                for r = 0 to R - 1
                    colDelta := colDelta + array.get(buyV, b * R + r) - array.get(sellV, b * R + r)
                cvd := cvd + colDelta
                if b == 0
                    fpLastDlt := colDelta
                    fpPocPx   := lo_ + (bestRow + 0.5) * rowH
    fpCvd := cvd
    // max |delta| for colour scaling
    float maxD = 0.0
    for b = 0 to N - 1
        for r = 0 to R - 1
            maxD := math.max(maxD, math.abs(array.get(buyV, b * R + r) - array.get(sellV, b * R + r)))
    maxD := maxD > 0 ? maxD : 1.0
    // draw
    for b = 0 to N - 1
        float hi_ = high[b]
        float lo_ = low[b]
        float rng = hi_ - lo_
        if rng > 0
            float rowH = rng / R
            for r = 0 to R - 1
                float bv = array.get(buyV, b * R + r)
                float sv = array.get(sellV, b * R + r)
                float tv = bv + sv
                if tv > 0
                    float dlt = bv - sv
                    bool  imbB = b < N - 1 and r > 0 and sv > 0 and bv >= fpImbalance * array.get(sellV, (b + 1) * R + (r - 1))
                    bool  imbS = b < N - 1 and r < R - 1 and bv > 0 and sv >= fpImbalance * array.get(buyV, (b + 1) * R + (r + 1))
                    int   tr   = math.max(38, math.round(92 - math.abs(dlt) / maxD * 54))
                    color bc   = dlt >= 0 ? color.new(#00C853, tr) : color.new(#FF1744, tr)
                    color bd   = r == array.get(pocIx, b) ? color.new(color.yellow, 0) : imbB or imbS ? color.new(color.white, 25) : color.new(color.black, 65)
                    string tx = fpText ? f_vol(tv) + (imbB ? " ▲" : imbS ? " ▼" : r == array.get(pocIx, b) ? " ●" : "") : ""
                    box nb = box.new(time[b], lo_ + (r + 1) * rowH, time[b] + bMs, lo_ + r * rowH, bd, r == array.get(pocIx, b) ? 2 : 1, line.style_solid, extend.none, xloc.bar_time, bc, tx, size.tiny, color.new(color.white, 6), text.align_right, text.align_center, text.wrap_none)
                    array.push(fpBoxes, nb)

// ═══════════════════════════════════════════════════════════════════════════
//  PLOT LAYER — the strategy made visible
// ═══════════════════════════════════════════════════════════════════════════
floatPnl := posDir != 0 and not na(posEntry) ? (close - posEntry) * posDir * posLots * contractSize + posRealized : 0.0
float equityNow = balance + floatPnl

plot(showLiquidity and asianHigh > 0 ? asianHigh : na,       "Asian High",     color.new(color.gold, 25),   1, plot.style_linebr)
plot(showLiquidity and asianLow > 0 and asianLow < 1e8 ? asianLow : na, "Asian Low", color.new(color.gold, 25), 1, plot.style_linebr)
plot(showLiquidity and londonHigh > 0 ? londonHigh : na,     "London High",    color.new(color.silver, 20), 1, plot.style_linebr)
plot(showLiquidity and londonLow > 0 and londonLow < 1e8 ? londonLow : na, "London Low", color.new(color.silver, 20), 1, plot.style_linebr)
plot(showLiquidity and pdh > 0 ? pdh : na,                   "Prev Day High",  color.new(#FF9800, 15),      1, plot.style_linebr)
plot(showLiquidity and pdl > 0 ? pdl : na,                   "Prev Day Low",   color.new(#FF9800, 15),      1, plot.style_linebr)
plot(showLiquidity and midnightOpen > 0 ? midnightOpen : na, "Midnight Open",  color.new(color.aqua, 25),   1, plot.style_linebr)
plot(showEmaRibbon ? ema20 : na,                             "EMA 20",         color.new(#29B6F6, 25),      1)
plot(showEmaRibbon ? ema50 : na,                             "EMA 50",         color.new(#FFB300, 15),      2)
plot(showEmaRibbon ? ema200 : na,                            "EMA 200",        color.new(#AB47BC, 5),       2)
plot(showBB50 ? bbBasis : na,                                "BB50 Basis",     color.new(#78909C, 25),      1, plot.style_cross)
plot(showUtBot ? utStop : na,                                "UT-Bot Trail",   close > utStop ? color.new(#00E676, 0) : color.new(#FF5252, 0), 2)

color kzBg = inNyAmBar ? color.new(#FF9800, 92) : inNyPmBar ? color.new(#7E57C2, 90) : inPreNyBar ? color.new(#29B6F6, 92) : inLonBar ? color.new(#66BB6A, 93) : na
bgcolor(showKillzones ? kzBg : na, title = "Killzone Windows")
bgcolor(showKillzones and whipBarNow ? color.new(#F44336, 84) : na, title = "NYSE Whip Bar (skipped)")
bgcolor(showKillzones and lateBuyBar ? color.new(#795548, 88) : na, title = "Late-Buy Block Bar")
bgcolor(showKillzones and not inTrackBar ? color.new(#263238, 94) : na, title = "Outside Sweep Tracking")

plotshape(showSignalMarks and sigDirOut > 0, "Long Setup",  shape.triangleup,   location.belowbar, color.new(#00E5FF, 0), size = size.small, text = "")
plotshape(showSignalMarks and sigDirOut < 0, "Short Setup", shape.triangledown, location.abovebar, color.new(#FFD740, 0), size = size.small, text = "")
plotshape(showSignalMarks and rawDirOut != 0 and sigDirOut == 0, "Blocked Setup", shape.xcross, location.abovebar, color.new(color.gray, 45), size = size.tiny, text = "")

// ═══════════════════════════════════════════════════════════════════════════
//  TABLES
// ═══════════════════════════════════════════════════════════════════════════
f_hdr(table t, int r, string txt, int cols) =>
    table.cell(t, 0, r, txt, text_color = color.white, text_size = tblSz, text_halign = text.align_center, bgcolor = color.new(#1565C0, 40), width = cols)

f_k(table t, int c, int r, string txt) =>
    table.cell(t, c, r, txt, text_color = color.new(color.white, 32), text_size = tblSz, text_halign = text.align_left, bgcolor = tblBg)

f_v(table t, int c, int r, string txt, color fg) =>
    table.cell(t, c, r, txt, text_color = fg, text_size = tblSz, text_halign = text.align_right, bgcolor = tblBg)

f_wide(table t, int c, int r, string txt, color fg, int w) =>
    table.cell(t, c, r, txt, text_color = fg, text_size = tblSz, text_halign = text.align_left, bgcolor = tblBg, width = w)

f_pnlColor(float x) =>
    x > 0 ? color.new(#00E676, 0) : x < 0 ? color.new(#FF5252, 0) : color.new(color.white, 35)

float winRate    = trades > 0 ? wins / trades * 100.0 : 0.0
float profFactor = grossLoss > 0 ? grossProfit / grossLoss : grossProfit > 0 ? 999.0 : 0.0
float avgR       = trades > 0 ? sumR / trades : 0.0
float avgWinR    = wins > 0 ? sumWinR / wins : 0.0
float avgLossR   = losses > 0 ? sumLossR / losses : 0.0
float avgWinUsd  = wins > 0 ? grossProfit / wins : 0.0
float avgLossUsd = losses > 0 ? grossLoss / losses : 0.0
float payoff     = avgLossUsd > 0 ? avgWinUsd / avgLossUsd : 0.0
float expectancy = trades > 0 ? netProfit / trades : 0.0
float retPct     = startBalance > 0 ? netProfit / startBalance * 100.0 : 0.0
float buyWr      = buyTrades > 0 ? buyWins / buyTrades * 100.0 : 0.0
float sellWr     = sellTrades > 0 ? sellWins / sellTrades * 100.0 : 0.0
string posTxt    = posDir == 0 ? "FLAT" : (posDir > 0 ? "LONG " : "SHORT ") + f_lots(nz(posLots)) + " · " + posEngine + " · " + posWindow
string pendTxt   = pendDir == 0 ? "—" : (pendDir > 0 ? "BUY LIMIT " : "SELL LIMIT ") + f_px(nz(pendPrice)) + " · " + str.tostring(bar_index - pendCreatedBar) + "/" + str.tostring(pExpiry + 1) + " bars"
string sweepTxt  = (bullSweepActive ? "SSL swept " + f_px(bullSweptLevel) + " (" + str.tostring(bullSweepBars) + "/" + str.tostring(pMaxMss) + ")" : "SSL —") + "\n" + (bearSweepActive ? "BSL swept " + f_px(bearSweptLevel) + " (" + str.tostring(bearSweepBars) + "/" + str.tostring(pMaxMss) + ")" : "BSL —")
string biasTxt   = bullBiasOut and not bearBiasOut ? "BULL" : bearBiasOut and not bullBiasOut ? "BEAR" : bullBiasOut and bearBiasOut ? "CONFLICT" : "FLAT / FILTERED"

if showTable and barstate.islast
    if na(statsTbl)
        statsTbl := table.new(statsPos, 4, 30, tblBg, color.new(color.gray, 65), 1, color.new(color.gray, 45), 1)
    f_hdr(statsTbl, 0, "AMD + GOLDFUSION v3.40 · SIMULATION LEDGER", 4)
    f_k(statsTbl, 0, 1, "Trades")
    f_v(statsTbl, 1, 1, str.tostring(trades), tblFg)
    f_k(statsTbl, 2, 1, "Win rate")
    f_v(statsTbl, 3, 1, f_pct(winRate), winRate >= 50 ? color.new(#00E676, 0) : color.new(#FF5252, 0))
    f_k(statsTbl, 0, 2, "Wins")
    f_v(statsTbl, 1, 2, str.tostring(wins), color.new(#00E676, 10))
    f_k(statsTbl, 2, 2, "Losses")
    f_v(statsTbl, 3, 2, str.tostring(losses), color.new(#FF5252, 10))
    f_k(statsTbl, 0, 3, "TP hits (1.95R)")
    f_v(statsTbl, 1, 3, str.tostring(tpHits), color.new(#00E676, 10))
    f_k(statsTbl, 2, 3, "SL hits (-1R)")
    f_v(statsTbl, 3, 3, str.tostring(slHits), color.new(#FF5252, 10))
    f_k(statsTbl, 0, 4, "Step-Lock exits")
    f_v(statsTbl, 1, 4, str.tostring(lockExits), color.new(#26C6DA, 0))
    f_k(statsTbl, 2, 4, "Shield exits")
    f_v(statsTbl, 3, 4, str.tostring(shieldExits), color.new(#FFA726, 0))
    f_k(statsTbl, 0, 5, "Session-end exits")
    f_v(statsTbl, 1, 5, str.tostring(sessionExits), tblFg)
    f_k(statsTbl, 2, 5, "Expired limits")
    f_v(statsTbl, 3, 5, str.tostring(expiredPendings), color.new(color.white, 45))
    f_k(statsTbl, 0, 6, "Partials taken")
    f_v(statsTbl, 1, 6, str.tostring(partialCount), color.new(#26C6DA, 0))
    f_k(statsTbl, 2, 6, "Avg R / trade")
    f_v(statsTbl, 3, 6, f_r(avgR), f_pnlColor(avgR))
    f_hdr(statsTbl, 7, "MONEY  (contract " + str.tostring(contractSize, "#") + " oz · spread " + str.tostring(simSpreadPoints, "#") + " pts)", 4)
    f_k(statsTbl, 0, 8, "Net profit")
    f_v(statsTbl, 1, 8, f_money(netProfit), f_pnlColor(netProfit))
    f_k(statsTbl, 2, 8, "Return on " + f_money(startBalance))
    f_v(statsTbl, 3, 8, f_pct(retPct), f_pnlColor(retPct))
    f_k(statsTbl, 0, 9, "Gross profit")
    f_v(statsTbl, 1, 9, f_money(grossProfit), color.new(#00E676, 15))
    f_k(statsTbl, 2, 9, "Gross loss")
    f_v(statsTbl, 3, 9, f_money(-grossLoss), color.new(#FF5252, 15))
    f_k(statsTbl, 0, 10, "Profit factor")
    f_v(statsTbl, 1, 10, str.tostring(profFactor, "#.##"), profFactor >= 1 ? color.new(#00E676, 0) : color.new(#FF5252, 0))
    f_k(statsTbl, 2, 10, "Expectancy")
    f_v(statsTbl, 3, 10, f_money(expectancy), f_pnlColor(expectancy))
    f_k(statsTbl, 0, 11, "Avg win $")
    f_v(statsTbl, 1, 11, f_money(avgWinUsd), color.new(#00E676, 15))
    f_k(statsTbl, 2, 11, "Avg loss $")
    f_v(statsTbl, 3, 11, f_money(-avgLossUsd), color.new(#FF5252, 15))
    f_k(statsTbl, 0, 12, "Payoff (win/loss)")
    f_v(statsTbl, 1, 12, str.tostring(payoff, "#.##"), tblFg)
    f_k(statsTbl, 2, 12, "Avg win / loss R")
    f_v(statsTbl, 3, 12, str.tostring(avgWinR, "#.##") + " / " + str.tostring(avgLossR, "#.##"), tblFg)
    f_k(statsTbl, 0, 13, "Best R")
    f_v(statsTbl, 1, 13, f_r(bestR), color.new(#00E676, 10))
    f_k(statsTbl, 2, 13, "Worst R")
    f_v(statsTbl, 3, 13, f_r(worstR), color.new(#FF5252, 10))
    f_k(statsTbl, 0, 14, "Max drawdown")
    f_v(statsTbl, 1, 14, f_money(-maxDrawdown), color.new(#FF5252, 5))
    f_k(statsTbl, 2, 14, "Max DD %")
    f_v(statsTbl, 3, 14, f_pct(maxDrawdownPct), color.new(#FF5252, 5))
    f_k(statsTbl, 0, 15, "Max consec W / L")
    f_v(statsTbl, 1, 15, str.tostring(maxConsecWin) + " / " + str.tostring(maxConsecLoss), tblFg)
    f_k(statsTbl, 2, 15, "Open lots")
    f_v(statsTbl, 3, 15, str.tostring(nz(posInitLots), "#.##"), tblFg)
    f_k(statsTbl, 0, 16, "Balance")
    f_v(statsTbl, 1, 16, f_money(balance), tblFg)
    f_k(statsTbl, 2, 16, "Equity (float)")
    f_v(statsTbl, 3, 16, f_money(equityNow), f_pnlColor(equityNow - startBalance))
    f_hdr(statsTbl, 17, "DIRECTIONAL SPLIT", 4)
    f_k(statsTbl, 0, 18, "BUY  " + str.tostring(buyTrades) + " trades")
    f_v(statsTbl, 1, 18, f_pct(buyWr) + " WR", f_pnlColor(buyPnl))
    f_k(statsTbl, 2, 18, "BUY P&L")
    f_v(statsTbl, 3, 18, f_money(buyPnl), f_pnlColor(buyPnl))
    f_k(statsTbl, 0, 19, "SELL " + str.tostring(sellTrades) + " trades")
    f_v(statsTbl, 1, 19, f_pct(sellWr) + " WR", f_pnlColor(sellPnl))
    f_k(statsTbl, 2, 19, "SELL P&L")
    f_v(statsTbl, 3, 19, f_money(sellPnl), f_pnlColor(sellPnl))
    f_hdr(statsTbl, 20, "OPEN POSITION", 4)
    f_k(statsTbl, 0, 21, "Position")
    f_v(statsTbl, 1, 21, posTxt, posDir == 0 ? color.new(color.white, 45) : color.new(#29B6F6, 0))
    f_k(statsTbl, 2, 21, "Step-Lock stage")
    f_v(statsTbl, 3, 21, posDir == 0 ? "—" : "S" + str.tostring(posStep) + (posPartDone ? " +◑" : ""), color.new(#26C6DA, 0))
    f_k(statsTbl, 0, 22, "Entry")
    f_v(statsTbl, 1, 22, posDir == 0 ? "—" : f_px(posEntry), tblFg)
    f_k(statsTbl, 2, 22, "Float P&L")
    f_v(statsTbl, 3, 22, posDir == 0 ? "—" : f_money(floatPnl), f_pnlColor(floatPnl))
    f_k(statsTbl, 0, 23, "Stop")
    f_v(statsTbl, 1, 23, posDir == 0 ? "—" : f_px(posSL) + " (" + f_r(posDir == 0 ? 0 : (posSL - posEntry) * posDir / math.max(posRisk, tickSize)) + ")", color.new(#FF5252, 10))
    f_k(statsTbl, 2, 23, "Target")
    f_v(statsTbl, 3, 23, posDir == 0 ? "—" : f_px(posTP) + " (+" + str.tostring(pRrTarget, "#.##") + "R)", color.new(#00E676, 10))
    f_hdr(statsTbl, 24, "LIVE CONTEXT", 4)
    f_k(statsTbl, 0, 25, "Broker / NY")
    f_v(statsTbl, 1, 25, f_brokerClock(time) + " / " + f_nyClock(time), tblFg)
    f_k(statsTbl, 2, 25, "Killzone window")
    f_v(statsTbl, 3, 25, activeWindowOut, activeWindowOut == "—" ? color.new(color.white, 45) : color.new(#FF9800, 0))
    f_k(statsTbl, 0, 26, "Trend bias")
    f_v(statsTbl, 1, 26, biasTxt, bullBiasOut ? color.new(#00E676, 0) : bearBiasOut ? color.new(#FF5252, 0) : color.new(color.white, 40))
    f_k(statsTbl, 2, 26, "Counters AM/PM")
    f_v(statsTbl, 3, 26, str.tostring(nyAmTradesC) + "/" + str.tostring(pMaxNyAm) + " · " + str.tostring(nyPmTradesC) + "/" + str.tostring(pMaxNyPm), tblFg)
    f_k(statsTbl, 0, 27, "Pending order")
    f_v(statsTbl, 1, 27, pendTxt, pendDir == 0 ? color.new(color.white, 45) : color.new(#FFA726, 0))
    f_k(statsTbl, 2, 27, "Cooldown left")
    f_v(statsTbl, 3, 27, str.tostring(math.max(0, pCooldown - barsSinceEntry)) + " bar(s)", tblFg)
    f_k(statsTbl, 0, 28, "Last event")
    f_wide(statsTbl, 1, 28, lastEvent, color.new(#FFD740, 0), 3)
    f_hdr(statsTbl, 29, "NON-REPAINT · closed-bar evaluation · " + timeframe.period + " · " + str.tostring(trades) + " simulated trades", 4)

if showBreakdown and barstate.islast
    if na(brkTbl)
        brkTbl := table.new(brkPos, 4, 13, tblBg, color.new(color.gray, 65), 1, color.new(color.gray, 45), 1)
    array<string> eNames = array.from("Engine 1 · AMD Sweep", "Engine 2 · L3 Turtle", "Engine 3 · Silver Bullet", "Engine 4 · GF SP2L", "Other")
    array<string> wNames = array.from("NY_AM 16:00-18:15", "NY_PM 20:00-20:45", "PRE_NY 14:00-15:30", "LON10 10:00-10:45", "Other")
    f_hdr(brkTbl, 0, "PERFORMANCE BREAKDOWN", 4)
    f_k(brkTbl, 0, 1, "Engine")
    f_v(brkTbl, 1, 1, "Trades", color.new(color.white, 40))
    f_v(brkTbl, 2, 1, "WR", color.new(color.white, 40))
    f_v(brkTbl, 3, 1, "Net $", color.new(color.white, 40))
    for i = 0 to 4
        float tN = array.get(engTrades, i)
        float wN = array.get(engWins, i)
        float pN = array.get(engPnl, i)
        f_k(brkTbl, 0, 2 + i, array.get(eNames, i))
        f_v(brkTbl, 1, 2 + i, str.tostring(tN, "#"), tblFg)
        f_v(brkTbl, 2, 2 + i, tN > 0 ? f_pct(wN / tN * 100.0) : "—", tN > 0 and wN / tN >= 0.5 ? color.new(#00E676, 0) : color.new(#FF5252, 0))
        f_v(brkTbl, 3, 2 + i, tN > 0 ? f_money(pN) : "—", f_pnlColor(pN))
    f_hdr(brkTbl, 7, "KILLZONE WINDOWS", 4)
    f_k(brkTbl, 0, 8, "Window")
    f_v(brkTbl, 1, 8, "Trades", color.new(color.white, 40))
    f_v(brkTbl, 2, 8, "WR", color.new(color.white, 40))
    f_v(brkTbl, 3, 8, "Net $", color.new(color.white, 40))
    for i = 0 to 3
        float tN = array.get(winTrades, i)
        float wN = array.get(winWins, i)
        float pN = array.get(winPnl, i)
        f_k(brkTbl, 0, 9 + i, array.get(wNames, i))
        f_v(brkTbl, 1, 9 + i, str.tostring(tN, "#"), tblFg)
        f_v(brkTbl, 2, 9 + i, tN > 0 ? f_pct(wN / tN * 100.0) : "—", tN > 0 and wN / tN >= 0.5 ? color.new(#00E676, 0) : color.new(#FF5252, 0))
        f_v(brkTbl, 3, 9 + i, tN > 0 ? f_money(pN) : "—", f_pnlColor(pN))

if showDashboard and barstate.islast
    if na(dashTbl)
        dashTbl := table.new(dashPos2, 2, 20, tblBg, color.new(color.gray, 65), 1, color.new(color.gray, 45), 1)
    f_hdr(dashTbl, 0, "LIVE DECISION ENGINE  (bar closed: " + str.format_time(time, "yy/MM/dd HH:mm", syminfo.timezone) + ")", 2)
    f_k(dashTbl, 0, 1, "Broker / New-York clock")
    f_v(dashTbl, 1, 1, f_brokerClock(time) + "  /  " + f_nyClock(time), tblFg)
    f_k(dashTbl, 0, 2, "Killzone (next bar open)")
    f_v(dashTbl, 1, 2, activeWindowOut + (inTrackOut ? "" : "  ·  tracking OFF"), inTrackOut ? color.new(#FF9800, 0) : color.new(color.white, 40))
    f_k(dashTbl, 0, 3, "Trend bias (EMA50/200)")
    f_v(dashTbl, 1, 3, biasTxt + (pStrictEma ? " · strict slope" : ""), bullBiasOut ? color.new(#00E676, 0) : bearBiasOut ? color.new(#FF5252, 0) : color.new(color.white, 40))
    f_k(dashTbl, 0, 4, "Liquidity sweeps")
    f_wide(dashTbl, 1, 4, sweepTxt, (bullSweepActive or bearSweepActive) ? color.new(#FFD740, 0) : color.new(color.white, 45), 1)
    f_k(dashTbl, 0, 5, "UT-Bot (" + str.tostring(utKeyValue, "#.#") + "×ATR" + str.tostring(utAtrPeriod) + ")")
    f_v(dashTbl, 1, 5, f_px(utStop) + (close > utStop ? "  ▲ LONG ok" : "  ▼ SHORT ok"), close > utStop ? color.new(#00E676, 0) : color.new(#FF5252, 0))
    f_k(dashTbl, 0, 6, "BB50 basis + slope")
    f_v(dashTbl, 1, 6, f_px(bbBasis) + (bbBasis > bbBasis1 ? " ▲ rising" : " ▼ falling") + (f_bbAllow(1, close, bbBasis, bbBasis1) ? " · BUY ok" : ""), f_bbAllow(1, close, bbBasis, bbBasis1) ? color.new(#00E676, 0) : color.new(#FF5252, 0))
    f_k(dashTbl, 0, 7, "GF filter scope")
    f_v(dashTbl, 1, 7, gfScopeStr, tblFg)
    f_k(dashTbl, 0, 8, "Reversal-shield vote")
    f_v(dashTbl, 1, 8, pbVoteOut == 0 ? "no pullback vote" : (pbVoteOut > 0 ? "BULL quorum building" : "BEAR quorum building") + (shieldFired ? "  ⚡ FIRED" : ""), pbVoteOut == 0 ? color.new(color.white, 45) : color.new(#FFA726, 0))
    f_k(dashTbl, 0, 9, "Engines armed")
    f_v(dashTbl, 1, 9, (pEng1 ? "E1✓ " : "E1✗ ") + (pEng2 ? "E2✓ " : "E2✗ ") + (pEng3 ? "E3✓ " : "E3✗ ") + (eng4On ? "E4✓" : "E4✗") + (eng4On and sp2lNyPmOnly ? " (NY_PM)" : ""), tblFg)
    f_k(dashTbl, 0, 10, "Raw setup this bar")
    f_v(dashTbl, 1, 10, rawDirOut == 0 ? "none" : rawEngineOut + (rawDirOut > 0 ? " BUY" : " SELL") + (rawWhyOut == "" ? " → ORDER SENT" : " → blocked: " + rawWhyOut), rawDirOut == 0 ? color.new(color.white, 45) : rawWhyOut == "" ? color.new(#00E5FF, 0) : color.new(#FF7043, 0))
    f_k(dashTbl, 0, 11, "Open position")
    f_v(dashTbl, 1, 11, posTxt, posDir == 0 ? color.new(color.white, 45) : color.new(#29B6F6, 0))
    f_k(dashTbl, 0, 12, "Entry / Stop / Target")
    f_v(dashTbl, 1, 12, posDir == 0 ? "—" : f_px(posEntry) + " / " + f_px(posSL) + " / " + f_px(posTP), tblFg)
    f_k(dashTbl, 0, 13, "Step-Lock stage · float")
    f_v(dashTbl, 1, 13, (posDir == 0 ? "—" : "S" + str.tostring(posStep) + (posPartDone ? " +◑ partial" : "")) + " · " + f_money(floatPnl), f_pnlColor(floatPnl))
    f_k(dashTbl, 0, 14, "Pending limit")
    f_v(dashTbl, 1, 14, pendTxt, pendDir == 0 ? color.new(color.white, 45) : color.new(#FFA726, 0))
    f_k(dashTbl, 0, 15, "Session liquidity")
    f_wide(dashTbl, 1, 15, "Asian  " + (asianHigh > 0 ? f_px(asianHigh) + " / " + f_px(asianLow) : "—") + "\nLondon " + (londonHigh > 0 ? f_px(londonHigh) + " / " + f_px(londonLow) : "—") + "\nPDH " + (pdh > 0 ? f_px(pdh) : "—") + " / PDL " + (pdl > 0 ? f_px(pdl) : "—") + "\nMidnight " + (midnightOpen > 0 ? f_px(midnightOpen) : "—"), color.new(color.gold, 15), 1)
    f_k(dashTbl, 0, 16, "Trade caps AM/PM/PRE/LON")
    f_v(dashTbl, 1, 16, str.tostring(nyAmTradesC) + "/" + str.tostring(pMaxNyAm) + " · " + str.tostring(nyPmTradesC) + "/" + str.tostring(pMaxNyPm) + " · " + str.tostring(preNyTradesC) + "/" + str.tostring(maxTradesPreNy) + " · " + str.tostring(lonTradesC) + "/1", tblFg)
    f_k(dashTbl, 0, 17, "Footprint Δ last bar")
    f_v(dashTbl, 1, 17, showFootprint ? (na(fpLastDlt) ? "—" : f_vol(fpLastDlt) + (fpLastDlt >= 0 ? " net long" : " net short") + " · POC " + f_px(fpPocPx)) : "disabled", showFootprint ? f_pnlColor(nz(fpLastDlt)) : color.new(color.white, 45))
    f_k(dashTbl, 0, 18, "Footprint CVD (" + str.tostring(fpBars) + " bars)")
    f_v(dashTbl, 1, 18, showFootprint ? (na(fpCvd) ? "—" : f_vol(fpCvd)) : "disabled", showFootprint ? f_pnlColor(nz(fpCvd)) : color.new(color.white, 45))
    f_k(dashTbl, 0, 19, "Last event")
    f_v(dashTbl, 1, 19, lastEvent, color.new(#FFD740, 0))

// ── environment warnings ──
if barstate.islast
    bool needTf  = requireM15 and not correctTf
    bool needVol = showFootprint and nz(volume) <= 0
    if needTf or needVol
        if na(warnTbl)
            warnTbl := table.new(position.top_center, 1, 2, color.new(color.black, 100), color.new(color.black, 100), 0)
        if needTf
            table.cell(warnTbl, 0, 0, "⚠  This port replicates an M15 expert advisor — the chart is on " + timeframe.period + ". Switch to 15 minutes for faithful signals.", text_color = color.white, text_size = tblSz, bgcolor = color.new(#B71C1C, 12))
        else
            table.cell(warnTbl, 0, 0, "", text_color = color.new(color.black, 100), text_size = size.tiny, bgcolor = color.new(color.black, 100))
        if needVol
            table.cell(warnTbl, 0, 1, "⚠  This symbol reports no volume — the footprint module stays empty.", text_color = color.white, text_size = tblSz, bgcolor = color.new(#E65100, 12))
        else
            table.cell(warnTbl, 0, 1, "", text_color = color.new(color.black, 100), text_size = size.tiny, bgcolor = color.new(color.black, 100))
    else if not na(warnTbl)
        table.delete(warnTbl)
        warnTbl := na

// ═══════════════════════════════════════════════════════════════════════════
//  ALERTS
// ═══════════════════════════════════════════════════════════════════════════
alertcondition(evSignal,  "AMD Fusion · Setup detected",   "AMD Fusion v3.40 setup on {ticker} {interval}")
alertcondition(evEntry,   "AMD Fusion · Order filled",     "AMD Fusion v3.40 position opened on {ticker} {interval}")
alertcondition(evPartial, "AMD Fusion · Step-1 partial",   "AMD Fusion v3.40 took the Step-1 partial on {ticker}")
alertcondition(evExit,    "AMD Fusion · Position closed",  "AMD Fusion v3.40 closed a position on {ticker} {interval}")
alertcondition(evShield,  "AMD Fusion · Reversal shield",  "AMD Fusion v3.40 reversal-quorum shield fired on {ticker}")
alertcondition(utFlipUp,  "UT-Bot flipped LONG",           "GoldFusion UT-Bot turned bullish on {ticker} {interval}")
alertcondition(utFlipDown,"UT-Bot flipped SHORT",          "GoldFusion UT-Bot turned bearish on {ticker} {interval}")
